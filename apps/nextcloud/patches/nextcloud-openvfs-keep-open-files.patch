+void OpenVFS::freeUp(const QString &folderPath)
+{
+    const auto localPath = params().root() / folderPath;
+    if (QFileInfo(localPath.toString()).isFile()) {
+        forgetOpen(FileSystem::toFilesystemPath(localPath.toString()));
+        return;
+    }
+    auto path = folderPath.toUtf8();
+    while (path.endsWith('/')) {
+        path.chop(1);
+    }
+    // Collect first: the journal stays locked while the callback runs.
+    QList<QByteArray> files;
+    if (!params().journal->getFilesBelowPath(path, [&files](const SyncJournalFileRecord &record) {
+            if (record._type == ItemTypeFile) {
+                files.append(record._path);
+            }
+        })) {
+        qCWarning(lcOpenVFS) << "Could not read the items below" << folderPath;
+        return;
+    }
+    for (const auto &file : std::as_const(files)) {
+        forgetOpen(FileSystem::toFilesystemPath((params().root() / QString::fromUtf8(file)).toString()));
+    }
+}
