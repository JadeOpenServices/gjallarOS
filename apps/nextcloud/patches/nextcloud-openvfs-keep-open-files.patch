+// Whether the folder holding folderPath frees up what it holds.
+bool OpenVFS::wantsOnlineOnly(const QString &folderPath)
+{
+    const auto parent = FileSystem::Path::relative(folderPath).get().parent_path();
+    const auto pin = pinState(QString::fromStdString(parent.string()));
+    return pin && *pin == PinState::OnlineOnly;
+}
+
+// A file a program opened, or made, below an online-only folder gets its own
+// Unspecified pin and stays on disk. A pin the user chose stays as it is.
+void OpenVFS::keepAfterOpen(::OpenVFS::PlaceHolderAttributes &attributes, const QString &folderPath)
+{
+    if (attributes.pinState == ::OpenVFS::Constants::PinStates::Inherited && wantsOnlineOnly(folderPath)) {
+        attributes.pinState = convertPinState(PinState::Unspecified);
+    }
+}
