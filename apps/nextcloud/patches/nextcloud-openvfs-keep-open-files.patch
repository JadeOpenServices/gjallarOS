+// openvfs sends this when the last program closes a file freed up while it
+// was open: the file is emptied now instead of at the next sync.
+void SocketApi::command_V2_FILE_CLOSED(const QSharedPointer<SocketApiJobV2> &job) const
+{
+    const auto fileData = FileData::get(job->arguments()[QStringLiteral("file")].toString());
+    if (!fileData.folder) {
+        job->failure(QStringLiteral("unknown file"));
+        return;
+    }
+    fileData.folder->schedulePathForLocalDiscovery(fileData.folderRelativePath);
+    fileData.folder->scheduleThisFolderSoon();
+    job->success({{QStringLiteral("status"), QStringLiteral("OK")}});
+}
