+// A file a program opened stays on disk. It goes back to online-only once no
+// program has opened it for this long.
+constexpr auto keptAfterOpen = std::chrono::days(14);
+
+// openvfs answers this for every file it serves. Without an answer the file
+// counts as open: freeing it up later loses nothing, emptying it while a
+// program reads it would.
+bool inUse(const std::filesystem::path &path)
+{
+    const auto value = OCC::FileSystem::Xattr::getxattr(path, QString::fromUtf8(OpenVFS::Constants::XAttributeNames::InUse));
+    if (!value) {
+        qCWarning(lcOpenVFS) << u"openvfs did not say whether the file is open" << path.native();
+        return true;
+    }
+    return *value != "0";
+}
+
+// Time since a program other than the client last opened the file, noted by
+// openvfs. A free-up sets it to 0. A file without a readable time starts its
+// time now; a time in the future counts as now.
+std::chrono::seconds sinceLastOpen(const std::filesystem::path &path)
+{
+    const auto name = QString::fromUtf8(OpenVFS::Constants::XAttributeNames::LastOpen);
+    const auto now = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+    if (const auto stored = OCC::FileSystem::Xattr::getxattr(path, name); stored && stored->size() <= 20) {
+        bool ok = false;
+        const auto last = stored->toLongLong(&ok);
+        if (ok) {
+            return std::chrono::seconds(std::max<qint64>(0, now - last));
+        }
+    }
+    if (const auto result = OCC::FileSystem::Xattr::setxattr(path, name, QByteArray::number(now)); !result) {
+        qCWarning(lcOpenVFS) << u"Failed to note the open time of" << path.native() << result.error();
+    }
+    return 0s;
+}
+
+// The user freed up the file: its open time goes to 0, so it is emptied as
+// soon as no program has it open, also when a program opened it lately.
+// openvfs tells the client when the last program closes it.
+void forgetOpen(const std::filesystem::path &path)
+{
+    const auto attributes = placeHolderAttributes(path);
+    if (!attributes || attributes.state != OpenVFS::Constants::States::Hydrated
+        || attributes.pinState == OpenVFS::Constants::PinStates::Excluded) {
+        return;
+    }
+    const auto name = QString::fromUtf8(OpenVFS::Constants::XAttributeNames::LastOpen);
+    if (const auto stored = OCC::FileSystem::Xattr::getxattr(path, name); stored && *stored == "0") {
+        return;
+    }
+    if (const auto result = OCC::FileSystem::Xattr::setxattr(path, name, QByteArrayLiteral("0")); !result) {
+        qCWarning(lcOpenVFS) << u"Failed to free up" << path.native() << result.error();
+    }
+}
