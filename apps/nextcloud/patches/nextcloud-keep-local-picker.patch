+QStringList SelectiveSyncWidget::createCheckedList(QTreeWidgetItem *root) const
+{
+    const auto top = _folderTree->topLevelItem(0);
+    if (!root) {
+        root = top;
+    }
+    if (!root) {
+        return {};
+    }
+    if (root != top) {
+        switch (root->checkState(0)) {
+        case Qt::Unchecked:
+            return {};
+        case Qt::Checked:
+            return {root->data(0, Qt::UserRole).toString() + QLatin1Char('/')};
+        case Qt::PartiallyChecked:
+            break;
+        }
+    } else if (root->checkState(0) == Qt::Unchecked) {
+        return {};
+    }
+
+    QStringList result;
+    for (int i = 0; i < root->childCount(); ++i) {
+        result += createCheckedList(root->child(i));
+    }
+    return result;
+}
+
+qint64 SelectiveSyncWidget::checkedFoldersSize(QTreeWidgetItem *root) const
+{
+    const auto top = _folderTree->topLevelItem(0);
+    if (!root) {
+        root = top;
+    }
+    if (!root) {
+        return 0;
+    }
+    if (root != top) {
+        switch (root->checkState(0)) {
+        case Qt::Unchecked:
+            return 0;
+        case Qt::Checked:
+            return root->data(1, Qt::UserRole).toLongLong();
+        case Qt::PartiallyChecked:
+            break;
+        }
+    } else if (root->checkState(0) == Qt::Unchecked) {
+        return 0;
+    }
+
+    qint64 result = 0;
+    for (int i = 0; i < root->childCount(); ++i) {
+        result += checkedFoldersSize(root->child(i));
+    }
+    return result;
+}
