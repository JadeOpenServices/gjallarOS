+            if (!_keepLocalDialog) {
+                return;
+            }
+            // "Not now" or closing the window keeps everything online-only.
+            _keepLocalPicks = _keepLocalDialog->result() == QDialog::Accepted ? _keepLocalDialog->checkedFolders() : QStringList();
