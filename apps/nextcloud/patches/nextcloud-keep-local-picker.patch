+KeepLocalDialog::KeepLocalDialog(AccountPtr account, const QString &folder, const QString &localPath, QWidget *parent, Qt::WindowFlags f)
+    : QDialog(parent, f)
+    , _localPath(localPath)
+{
+    setWindowTitle(tr("Keep on this device"));
+    auto *layout = new QVBoxLayout(this);
+    _selectiveSync = new SelectiveSyncWidget(account, this);
+    _selectiveSync->setHeaderText(tr("Files stay online and download when you open them. "
+                                     "Tick the folders to download now and keep on this device. "
+                                     "New files in a ticked folder download too, also files others add to it."));
+    // Nothing ticked: every top-level folder starts unchecked.
+    _selectiveSync->setFolderInfo(folder, folder, {QStringLiteral("/")});
+    layout->addWidget(_selectiveSync);
+
+    _sizeLabel = new QLabel(this);
+    _sizeLabel->setWordWrap(true);
+    layout->addWidget(_sizeLabel);
+    connect(_selectiveSync, &SelectiveSyncWidget::checkStateChanged, this, &KeepLocalDialog::updateSizeLabel);
+    updateSizeLabel();
+
+    auto *buttonBox = new QDialogButtonBox(Qt::Horizontal);
+    auto *okButton = buttonBox->addButton(QDialogButtonBox::Ok);
+    connect(okButton, &QPushButton::clicked, this, &QDialog::accept);
+    auto *laterButton = buttonBox->addButton(tr("Not now"), QDialogButtonBox::RejectRole);
+    connect(laterButton, &QAbstractButton::clicked, this, &QDialog::reject);
+    layout->addWidget(buttonBox);
+}
+
+QStringList KeepLocalDialog::checkedFolders() const
+{
+    return _selectiveSync->createCheckedList();
+}
+
+void KeepLocalDialog::updateSizeLabel()
+{
+    // The sync folder may not exist yet: ask the nearest existing parent.
+    auto info = QFileInfo(_localPath);
+    while (!_localPath.isEmpty() && !info.exists() && info.absolutePath() != info.absoluteFilePath()) {
+        info = QFileInfo(info.absolutePath());
+    }
+    const auto freeSpace = _localPath.isEmpty() || !info.exists() ? -1 : Utility::freeDiskSpace(info.absoluteFilePath());
+    const auto picked = Utility::octetsToString(_selectiveSync->checkedFoldersSize());
+    _sizeLabel->setText(freeSpace < 0 ? tr("To download: %1").arg(picked)
+                                      : tr("To download: %1, free on this device: %2").arg(picked, Utility::octetsToString(freeSpace)));
+}
 }
