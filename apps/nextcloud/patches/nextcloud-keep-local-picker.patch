+void Folder::applyKeepLocalPicks(bool dropMissing)
+{
+    if (_definition.virtualFilesMode == Vfs::Off) {
+        return;
+    }
+    bool ok = false;
+    const auto picks = _journal.getSelectiveSyncList(SyncJournalDb::KeepLocalPickList, &ok);
+    if (!ok || picks.isEmpty()) {
+        return;
+    }
+    QStringList pending;
+    int pinned = 0;
+    int dropped = 0;
+    for (const auto &pick : picks) {
+        const auto path = pick.endsWith(QLatin1Char('/')) ? pick.chopped(1) : pick;
+        if (_vfs->setPinState(path, PinState::AlwaysLocal)) {
+            ++pinned;
+            continue;
+        }
+        SyncJournalFileRecord record;
+        if (dropMissing && _journal.getFileRecord(path, &record) && !record.isValid()) {
+            ++dropped;
+            continue;
+        }
+        pending.append(pick);
+    }
+    if (pending.size() != picks.size()) {
+        _journal.setSelectiveSyncList(SyncJournalDb::KeepLocalPickList, pending);
+    }
+    // Counts only: folder names stay out of the log.
+    qCInfo(lcFolder) << "Keep-local picks: pinned" << pinned << "dropped" << dropped << "pending" << pending.size();
+}
