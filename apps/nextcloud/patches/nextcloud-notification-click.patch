+
+#ifdef USE_FDO_NOTIFICATIONS
+    // A click on one of our notifications opens the tray window, like a
+    // click on the tray icon. Only the notification server can send these.
+    QDBusConnection::sessionBus().connect(NOTIFICATIONS_SERVICE, NOTIFICATIONS_PATH, NOTIFICATIONS_IFACE,
+        QStringLiteral("ActionInvoked"), this, SLOT(slotNotificationActionInvoked(uint,QString)));
+    QDBusConnection::sessionBus().connect(NOTIFICATIONS_SERVICE, NOTIFICATIONS_PATH, NOTIFICATIONS_IFACE,
+        QStringLiteral("NotificationClosed"), this, SLOT(slotNotificationClosed(uint,uint)));
+#endif
+}
+
+void Systray::slotNotificationActionInvoked(uint id, const QString &actionKey)
+{
+    if (actionKey != "default"_L1 || !_notificationIds.remove(id)) {
+        return;
+    }
+    showTrayPopup(WindowPosition::Center);
+}
+
+void Systray::slotNotificationClosed(uint id, uint reason)
+{
+    Q_UNUSED(reason)
+    _notificationIds.remove(id);
 }
 
