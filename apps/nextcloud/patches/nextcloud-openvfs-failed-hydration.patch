+// A failed hydration leaves the placeholder as createPlaceholder() made it:
+// empty, dehydrated, with the server's size and mtime.
+void restoreDehydrated(const QString &filePath, const OCC::SyncJournalFileRecord &record)
+{
+    auto attributes = placeHolderAttributes(filePath);
+    if (!attributes || attributes.state != OpenVFS::Constants::States::Hydrating) {
+        return;
+    }
+    QFile file(filePath);
+    if (!file.open(QFile::WriteOnly | QFile::Truncate)) {
+        qCWarning(lcOpenVFS) << u"Failed to empty placeholder after failed hydration" << filePath << file.errorString();
+        return;
+    }
+    file.close();
+    attributes.state = OpenVFS::Constants::States::DeHydrated;
+    OCC::Result<void, QString> result;
+    if (record.isValid()) {
+        attributes.size = record._fileSize;
+        result = setPlaceholderAttributes(attributes, record._modtime);
+    } else {
+        result = setPlaceholderAttributes(attributes);
+    }
+    if (!result) {
+        qCWarning(lcOpenVFS) << u"Failed to restore placeholder after failed hydration" << filePath << result.error();
+    }
+}
