+
+// True once the kernel lists an openvfs FUSE mount exactly at path.
+bool isOpenVfsMountPoint(const QString &path)
+{
+    QFile file(u"/proc/self/mountinfo"_s);
+    if (!file.open(QIODevice::ReadOnly)) {
+        qCWarning(lcOpenVFS) << "Failed to read /proc/self/mountinfo" << file.errorString();
+        return false;
+    }
+    const auto lines = file.readAll().split('\n');
+    for (const auto &line : lines) {
+        const auto fields = line.split(' ');
+        if (fields.size() >= 9 && fields[8] == "fuse.openvfs"
+            && OCC::FileSystem::isChildPathOf2(path, QString::fromUtf8(parseMangledPath(fields[4]))).testFlag(OCC::FileSystem::ChildResult::IsEqual)) {
+            return true;
+        }
+    }
+    return false;
+}
 #endif
 }
 
