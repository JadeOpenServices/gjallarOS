+// libfuse serves the whole mount from one pool of worker threads, and a
+// hydration wait holds its worker until the client has written the file.
+// Hydration waits may use at most OpenVFSMaxWorkers - OpenVFSReservedWorkers
+// workers; the rest stay free for short requests, the client's among them.
+// One process holds at most OpenVFSWaitsPerProcess of them, so a single app
+// opening many files cannot shut every other app out of hydrating.
+constexpr unsigned OpenVFSMaxWorkers = 64;
+constexpr unsigned OpenVFSReservedWorkers = 16;
+constexpr unsigned OpenVFSWaitsPerProcess = 16;
+
