+// The client writes a hydrated file, and reads its sync database, through
+// this same mount. If every worker waited for a hydration, the client's own
+// requests would find no worker and no hydration could finish. So a
+// hydration wait first takes one of the limited slots; with none left the
+// open fails at once instead of taking the last free workers.
+class HydrationSlot
+{
+public:
+    explicit HydrationSlot(pid_t callerThreadId)
+        : _process(processOf(callerThreadId))
+    {
+        const std::lock_guard lock(_mutex);
+        auto &mine = _perProcess[_process];
+        if (_total < OpenVFSMaxWorkers - OpenVFSReservedWorkers && mine < OpenVFSWaitsPerProcess) {
+            ++_total;
+            ++mine;
+            _acquired = true;
+        } else if (mine == 0) {
+            _perProcess.erase(_process);
+        }
+    }
+    ~HydrationSlot()
+    {
+        if (!_acquired) {
+            return;
+        }
+        const std::lock_guard lock(_mutex);
+        --_total;
+        if (--_perProcess[_process] == 0) {
+            _perProcess.erase(_process);
+        }
+    }
+    HydrationSlot(const HydrationSlot &) = delete;
+    HydrationSlot &operator=(const HydrationSlot &) = delete;
+    explicit operator bool() const { return _acquired; }
+
+private:
+    // fuse_context::pid is the calling thread; its process is the Tgid.
+    static pid_t processOf(pid_t threadId)
+    {
+#ifndef __APPLE__
+        std::ifstream status(std::format("/proc/{}/status", threadId));
+        for (std::string line; std::getline(status, line);) {
+            if (line.starts_with("Tgid:")) {
+                try {
+                    return static_cast<pid_t>(std::stol(line.substr(5)));
+                } catch (const std::exception &) {
+                    break;
+                }
+            }
+        }
+#endif
+        return threadId;
+    }
+
+    static inline std::mutex _mutex;
+    static inline unsigned _total = 0;
+    static inline std::unordered_map<pid_t, unsigned> _perProcess;
+    const pid_t _process;
+    bool _acquired = false;
+};
+
 
