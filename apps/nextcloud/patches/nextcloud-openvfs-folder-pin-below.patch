+void OpenVFS::resetPinsBelow(const QString &folderPath)
+{
+    auto path = folderPath.toUtf8();
+    while (path.endsWith('/')) {
+        path.chop(1);
+    }
+    // Collect first: the journal stays locked while the callback runs.
+    QList<QByteArray> below;
+    if (!params().journal->getFilesBelowPath(path, [&below](const SyncJournalFileRecord &record) {
+            below.append(record._path);
+        })) {
+        qCWarning(lcOpenVFS) << "Could not read the items below" << folderPath;
+        return;
+    }
+    const auto inherited = convertPinState(PinState::Inherited);
+    const auto excluded = convertPinState(PinState::Excluded);
+    for (const auto &item : std::as_const(below)) {
+        auto attribs = placeHolderAttributes(params().root() / QString::fromUtf8(item));
+        if (!attribs || attribs.pinState == inherited || attribs.pinState == excluded) {
+            continue;
+        }
+        attribs.pinState = inherited;
+        if (!setPlaceholderAttributes(attribs)) {
+            qCWarning(lcOpenVFS) << "Could not reset the pin of" << item;
+        }
+    }
+}
