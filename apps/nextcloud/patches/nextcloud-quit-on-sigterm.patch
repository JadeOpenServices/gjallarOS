+#ifdef Q_OS_UNIX
+    // systemd and session logout stop the client with SIGTERM. Quit as from
+    // the tray, so the folders stop and openvfs unmounts before the process
+    // exits; dying at once left the unmount to openvfs alone, after the
+    // client was gone.
+    static int quitSignalFds[2] = {-1, -1};
+    if (::socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, quitSignalFds) == 0) {
+        auto quitSignal = new QSocketNotifier(quitSignalFds[1], QSocketNotifier::Read, &app);
+        QObject::connect(quitSignal, &QSocketNotifier::activated, &app, [quitSignal] {
+            quitSignal->setEnabled(false);
+            QCoreApplication::quit();
+        });
+        struct sigaction quitAction{};
+        quitAction.sa_handler = [](int) {
+            const char byte = 1;
+            [[maybe_unused]] const auto written = ::write(quitSignalFds[0], &byte, 1);
+        };
+        sigemptyset(&quitAction.sa_mask);
+        quitAction.sa_flags = SA_RESTART;
+        sigaction(SIGTERM, &quitAction, nullptr);
+    }
+#endif
