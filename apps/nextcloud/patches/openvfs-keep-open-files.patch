+// Programs other than the client that have a file open, counted per inode of
+// the file below the mount. The client asks before it frees up a file, and
+// its own truncating open fails while the count is not zero, so a program
+// never sees a file it has open go empty. A mapping holds the file open until
+// the last munmap; FUSE sends release only then.
+class OpenFiles
+{
+public:
+    static void opened(uint64_t fh)
+    {
+        struct stat st{};
+        if (fstat(static_cast<int>(fh), &st) == -1 || !S_ISREG(st.st_mode)) {
+            return;
+        }
+        const std::lock_guard lock(_mutex);
+        const Key key{st.st_dev, st.st_ino};
+        if (_byHandle.emplace(fh, key).second) {
+            ++_count[key];
+        }
+    }
+    // Before the handle is closed: a closed descriptor number can be reused
+    // by the next open at once.
+    static void released(uint64_t fh)
+    {
+        const std::lock_guard lock(_mutex);
+        const auto handle = _byHandle.find(fh);
+        if (handle == _byHandle.end()) {
+            return;
+        }
+        if (const auto count = _count.find(handle->second); count != _count.end() && --count->second == 0) {
+            _count.erase(count);
+        }
+        _byHandle.erase(handle);
+    }
+    static bool inUse(const std::filesystem::path &path)
+    {
+        struct stat st{};
+        if (lstat(path.c_str(), &st) == -1 || !S_ISREG(st.st_mode)) {
+            return false;
+        }
+        const std::lock_guard lock(_mutex);
+        return _count.contains(Key{st.st_dev, st.st_ino});
+    }
+
+private:
+    using Key = std::pair<dev_t, ino_t>;
+    static inline std::mutex _mutex;
+    static inline std::map<Key, unsigned> _count;
+    static inline std::unordered_map<uint64_t, Key> _byHandle;
+};
+
+// The client frees up a file kept after opening once no program has opened it
+// for a while. Opens by the client and by programs that must not hydrate
+// (thumbnailers, indexers) do not count. Written at most once a day, so
+// reading a file does not rewrite its attributes on every open. A stored time
+// in the future counts as stale and is replaced.
+static void noteOpened(const std::filesystem::path &path)
+{
+    const long long now = std::chrono::duration_cast<std::chrono::seconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+    const auto name = OpenVFS::Constants::XAttributeNames::LastOpen.data();
+    char stored[24] = {};
+    const auto length = Xattr::getxattr(path, name, stored, sizeof(stored));
+    if (length > 0) {
+        long long last = 0;
+        const auto [end, error] = std::from_chars(stored, stored + length, last);
+        if (error == std::errc{} && end == stored + length && last <= now && now - last < 24 * 60 * 60) {
+            return;
+        }
+    }
+    const auto value = std::to_string(now);
+    if (Xattr::setxattr(path, name, value.data(), value.size(), 0) < 0) {
+        openvfsfuse_log(path, "open", -1, "could not note the open time");
+    }
+}
