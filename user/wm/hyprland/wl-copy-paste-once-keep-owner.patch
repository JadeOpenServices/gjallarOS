 static void pasted_callback(struct copy_action *copy_action) {
-    if (options.paste_once) {
-        exit(0);
+    if (!options.paste_once) {
+        return;
+    }
+    /* Drop the data but stay the selection owner. Exiting here clears
+     * the selection while the app is still handling the paste, and
+     * Chromium throws away data from a clipboard that changed during
+     * the paste, so the paste came out empty. Later reads get nothing;
+     * we exit when someone else copies (cancelled_callback).
+     */
+    if (copy_action->fd_to_copy_from != -1) {
+        int null_fd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+        if (null_fd < 0 || dup2(null_fd, copy_action->fd_to_copy_from) < 0) {
+            exit(0);
+        }
+        close(null_fd);
+        fcntl(copy_action->fd_to_copy_from, F_SETFD, FD_CLOEXEC);
+    } else {
+        copy_action->argv_to_copy = NULL;
+        copy_action->data_to_copy.ptr = "";
+        copy_action->data_to_copy.len = 0;
     }
 }
 
