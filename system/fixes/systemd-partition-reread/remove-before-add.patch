--- a/src/test/test-reread-partition-table.c
+++ b/src/test/test-reread-partition-table.c
@@ -168,6 +168,61 @@ TEST(rereadpt) {
         ASSERT_OK_ZERO_ERRNO(access(p, F_OK));
         ASSERT_OK(reread_partition_table_fd(loop->fd, /* flags= */ 0));
         ASSERT_ERROR_ERRNO(access(p, F_OK), ENOENT);
+
+        _cleanup_free_ char *p2 = NULL;
+        ASSERT_OK(partition_node_of(loop->node, 2, &p2));
+
+        /* Two partitions in reverse order on disk, like an image whose first partition sits behind its
+         * second one */
+        log_notice("CREATING TWO IN REVERSE ORDER");
+        sfdisk(sfdisk_path,
+               loop,
+               "label: gpt\n"
+               "start=30M, size=20M, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7\n"
+               "start=2M, size=5M, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7\n");
+
+        ASSERT_OK(reread_partition_table_fd(loop->fd, /* flags= */ 0));
+        ASSERT_OK_ZERO_ERRNO(access(p, F_OK));
+        ASSERT_OK_ZERO_ERRNO(access(p2, F_OK));
+
+        /* Both move, and the new partition 1 overlaps the old partition 2. The old partition 2 has to go
+         * before the new partition 1 can be added. */
+        log_notice("MOVING ONTO EACH OTHER");
+        sfdisk(sfdisk_path,
+               loop,
+               "label: gpt\n"
+               "start=1M, size=16M, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7\n"
+               "start=20M, size=10M, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7\n");
+
+        ASSERT_OK(reread_partition_table_fd(loop->fd, /* flags= */ REREADPT_FORCE_UEVENT));
+
+        pfd = ASSERT_OK_ERRNO(open(p, O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOCTTY));
+        ASSERT_OK(blockdev_get_device_size(pfd, &size));
+        ASSERT_EQ(size, 16U*1024U*1024U);
+        pfd = safe_close(pfd);
+
+        pfd = ASSERT_OK_ERRNO(open(p2, O_RDONLY|O_CLOEXEC|O_NONBLOCK|O_NOCTTY));
+        ASSERT_OK(blockdev_get_device_size(pfd, &size));
+        ASSERT_EQ(size, 10U*1024U*1024U);
+        pfd = safe_close(pfd);
+
