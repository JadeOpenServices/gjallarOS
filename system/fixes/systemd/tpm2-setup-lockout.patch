         if (ret == -ENOBUFS)
                 return EX_CANTCREAT;     /* NV index space on TPM exhausted */
+        if (ret == -ENOLCK)
+                return EX_TEMPFAIL;      /* TPM in dictionary attack lockout */
 
         return ret;
 }
@@ -541,7 +554,7 @@
         umask(0022);
 
