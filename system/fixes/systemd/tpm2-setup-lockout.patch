diff --git a/src/tpm2-setup/tpm2-setup.c b/src/tpm2-setup/tpm2-setup.c
index 8275bd3..4e5658a 100644
--- a/src/tpm2-setup/tpm2-setup.c
+++ b/src/tpm2-setup/tpm2-setup.c
@@ -428,10 +428,13 @@
                  * now, and haven't provided the anchor secret yet. Hence acquire it now. */
 
                 r = tpm2_nvpcr_acquire_anchor_secret(&c->anchor_secret, /* sync_secondary= */ !arg_early);
-                if (r < 0)
+                /* Unsealing a stored anchor secret fails with ENOLCK in dictionary attack lockout,
+                 * which is handled below like a lockout on the extend. */
+                if (r < 0 && r != -ENOLCK)
                         return log_error_errno(r, "Failed to acquire anchor secret: %m");
 
-                r = tpm2_nvpcr_initialize(c->tpm2_context, /* session= */ NULL, name, &c->anchor_secret);
+                if (r >= 0)
+                        r = tpm2_nvpcr_initialize(c->tpm2_context, /* session= */ NULL, name, &c->anchor_secret);
         }
         if (r == -EOPNOTSUPP) {
                 c->n_failed++;
@@ -449,6 +452,14 @@
                                         LOG_MESSAGE("The TPM's NV index space is exhausted, skipping allocation of NvPCR '%s' and any less important ones: %m", name),
                                         LOG_MESSAGE_ID(SD_MESSAGE_TPM_NVINDEX_EXHAUSTED_STR));
         }
+        if (r == -ENOLCK) {
+                /* The TPM is in dictionary attack lockout, so it refuses to unseal the stored anchor
