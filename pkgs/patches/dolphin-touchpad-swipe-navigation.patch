+void KItemListContainer::trackSwipe(const QWheelEvent *event)
+{
+    // Only touchpads (and other finger scrolling) send scroll phases; a mouse
+    // wheel never starts a swipe.
+    switch (event->phase()) {
+    case Qt::ScrollBegin:
+        // Compact view, or Details view with wide columns, scrolls sideways.
+        m_swipeTracking = horizontalScrollBar()->minimum() == horizontalScrollBar()->maximum();
+        m_swipeDistance = QPointF();
+        break;
+    case Qt::ScrollUpdate:
+        // pixelDelta() follows the scroll direction; with natural scrolling
+        // inverted() is set and it follows the fingers.
+        if (m_swipeTracking) {
+            m_swipeDistance += event->inverted() ? QPointF(event->pixelDelta()) : -QPointF(event->pixelDelta());
+        }
+        break;
+    case Qt::ScrollEnd: {
+        // Fingers moved right: back, as on a touchscreen (KItemListController::swipeTriggered).
+        const qreal minimumDistance = 120;
+        const qreal x = m_swipeDistance.x();
+        if (m_swipeTracking && qAbs(x) >= minimumDistance && qAbs(x) > 2 * qAbs(m_swipeDistance.y())) {
+            Q_EMIT m_controller->mouseButtonPressed(-1, x > 0 ? Qt::BackButton : Qt::ForwardButton);
+        }
+        m_swipeTracking = false;
+        break;
+    }
+    default:
+        break;
+    }
+}
