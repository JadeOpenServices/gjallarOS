@@ -20,17 +24,28 @@ class AutoMounter(DaemonBase):
 
     >>> automounter = AutoMounter(Mounter(udisks=Daemon()))
     >>> automounter.activate()
+
+    Like GNOME, it only mounts devices that appear within a few seconds of
+    their media being detected. A partition or filesystem that shows up later
+    was most likely just written by a tool (dd, mkfs, a partitioner, an
+    installer stick writer), and mounting it gets in that tool's way. Devices
+    present when udiskie starts are mounted by ``Mounter.add_all`` instead.
     """
 
+    #: seconds after the media was detected in which new devices are mounted
+    media_window = 5
+
     def __init__(self, mounter, automount=True):
         """Store mounter as member variable."""
         self._mounter = mounter
         self._automount = automount
+        self._log = logging.getLogger(__name__)
         self.events = {
             'device_changed': self.device_changed,
             'device_added': self.auto_add,
-            'media_added': self.auto_add,
+            'media_added': self.media_added,
         }
+        self._adding = set()
 
     def is_on(self):
         return self._automount
@@ -47,6 +62,36 @@ class AutoMounter(DaemonBase):
                 and not self._mounter.is_removable(old_state)):
             self.auto_add(new_state)
 
+    def media_added(self, device):
+        """Mount what is on newly inserted media."""
+        self.auto_add(device)
+        # udisks may send the new filesystem before the drive's new media
+        # time, so auto_add skipped it; now that the time is in, try again:
+        if device.is_drive:
+            for dev in self._mounter.get_all_handleable():
+                if (dev.is_block and dev.drive == device
+                        and self._mounter.is_addable(dev, self._automount)):
+                    self.auto_add(dev)
+
+    def is_new_media(self, device):
+        """Check whether the device appeared together with its media."""
+        if device.is_luks_cleartext:
+            # the user has just unlocked it
+            return True
+        detected = device.time_media_detected
+        # devices without a drive (e.g. loop devices) were set up by the user
+        return not detected or time.time() - detected < self.media_window
+
     @run_bg
-    def auto_add(self, device):
-        return self._mounter.auto_add(device, automount=self._automount)
+    async def auto_add(self, device):
+        if not self.is_new_media(device):
+            self._log.info(_('not mounting {0}: it appeared long after its media', device))
+            return True
+        if device.object_path in self._adding:
+            return True
+        self._adding.add(device.object_path)
+        try:
+            return await self._mounter.auto_add(
+                device, automount=self._automount)
+        finally:
+            self._adding.discard(device.object_path)
