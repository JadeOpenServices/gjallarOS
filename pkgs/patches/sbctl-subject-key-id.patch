--- a/backend/ski.go
+++ b/backend/ski.go
@@ -0,0 +1,30 @@
+package backend
+
+import (
+	"crypto"
+	"crypto/sha1"
+	"crypto/x509"
+	"encoding/asn1"
+	"fmt"
+)
+
+// subjectKeyID returns the Subject Key Identifier for pub, the SHA-1 of the
+// subjectPublicKey bit string (RFC 5280 4.2.1.2, method 1). Go adds the
+// extension only to CA certificates, but tools read it from end-entity
+// certificates too: mokutil --import looks the key up in the kernel keyring
+// by it and prints "Failed to get Subject Key ID" when it is missing.
+func subjectKeyID(pub crypto.PublicKey) ([]byte, error) {
+	der, err := x509.MarshalPKIXPublicKey(pub)
+	if err != nil {
+		return nil, fmt.Errorf("marshal public key: %w", err)
+	}
+	var spki struct {
+		Algorithm        asn1.RawValue
+		SubjectPublicKey asn1.BitString
+	}
+	if _, err := asn1.Unmarshal(der, &spki); err != nil {
+		return nil, fmt.Errorf("parse public key: %w", err)
+	}
+	sum := sha1.Sum(spki.SubjectPublicKey.Bytes)
+	return sum[:], nil
+}
--- a/backend/ski_test.go
+++ b/backend/ski_test.go
@@ -0,0 +1,26 @@
+package backend
+
+import (
+	"bytes"
+	"crypto/sha1"
+	"crypto/x509"
+	"testing"
+
+	"github.com/foxboron/sbctl/hierarchy"
+)
+
+func TestFileKeySubjectKeyID(t *testing.T) {
+	key, err := NewFileKey(hierarchy.Db, "Database Key")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Certificate() is parsed back from the DER that CreateCertificate made.
+	cert := key.Certificate()
+	if len(cert.SubjectKeyId) == 0 {
+		t.Fatal("the certificate has no Subject Key Identifier")
+	}
+	want := sha1.Sum(x509.MarshalPKCS1PublicKey(&key.privkey.PublicKey))
+	if !bytes.Equal(cert.SubjectKeyId, want[:]) {
+		t.Fatalf("Subject Key Identifier %x, want %x", cert.SubjectKeyId, want)
+	}
+}
