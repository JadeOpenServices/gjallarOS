+
+/* A device that is not authorized at plug-in (for example blocked by
+ * USBGuard) has no active configuration, so an application that looks at it
+ * on arrival skips it. Authorizing it later sends no uevent for the device
+ * itself; the kernel only selects a configuration and adds its interfaces.
+ * When an interface appears on a device that was enumerated unauthorized and
+ * is authorized now, report the device as leaving and arriving, so
+ * applications see it with its configuration. An unauthorized device cannot
+ * be configured by an application, so this only follows authorization. */
+void linux_hotplug_interface_added(uint8_t busnum, uint8_t devaddr, const char *sys_name)
+{
+	struct libusb_context *ctx;
+	struct libusb_device *dev;
+	unsigned long session_id = busnum << 8 | devaddr;
+	int authorized;
+
+	if (read_sysfs_attr(NULL, sys_name, "authorized", 1, &authorized) < 0 || authorized != 1)
+		return;
+
+	usbi_mutex_static_lock(&active_contexts_lock);
+	for_each_context(ctx) {
+		struct linux_device_priv *priv;
+
+		dev = usbi_get_device_by_session_id(ctx, session_id);
+		if (!dev)
+			continue;
+		priv = usbi_get_device_priv(dev);
+		if (priv->authorized != 0) {
+			libusb_unref_device(dev);
+			continue;
+		}
+		usbi_dbg(ctx, "session %lx authorized after enumeration, reporting it again",
+			 session_id);
+		usbi_disconnect_device(dev);
+		libusb_unref_device(dev);
+		linux_enumerate_device(ctx, busnum, devaddr, sys_name);
+	}
+	usbi_mutex_static_unlock(&active_contexts_lock);
+}
 
