+/* An interface was added. The kernel adds interfaces when it configures a
+ * device, which is also what happens when a device that was not authorized
+ * at plug-in gets authorized; no other uevent tells about that. */
+static void udev_interface_event(struct udev_device *udev_dev, const char *udev_action)
+{
+	struct udev_device *parent;
+	const char *sys_name = NULL;
+	uint8_t busnum = 0, devaddr = 0;
+
+	if (strcmp(udev_action, "add") != 0)
+		return;
+	/* Borrowed reference, freed with udev_dev */
+	parent = udev_device_get_parent_with_subsystem_devtype(udev_dev, "usb", "usb_device");
+	if (!parent)
+		return;
+	if (udev_device_info(NULL, 0, parent, &busnum, &devaddr, &sys_name) != LIBUSB_SUCCESS)
+		return;
+	linux_hotplug_interface_added(busnum, devaddr, sys_name);
+}
