+/// The application ID GTK registered, which follows the `class` config.
+pub fn appId() [:0]const u8 {
+    const app = gio.Application.getDefault() orelse return ApprtApp.application_id;
+    const id = app.getApplicationId() orelse return ApprtApp.application_id;
+    return std.mem.span(id);
+}
+
+/// Format the scope name as app-<launcher>-<ApplicationID>-<RANDOM>.scope
+/// (https://systemd.io/DESKTOP_ENVIRONMENTS/), so that xdg-desktop-portal
+/// and others can tell which application a process belongs to. Dashes in
+/// the application ID are escaped as \x2d, like systemd-escape does.
+pub fn fmtScope(buf: []u8, app_id: []const u8, pid: u32) [:0]const u8 {
+    return fmtScopeId(buf, app_id, pid) catch
+        fmtScopeId(buf, "com.mitchellh.ghostty", pid) catch unreachable;
+}
 
-    assert(buf.len >= fmt.len - 2 + std.math.log10_int(@as(usize, std.math.maxInt(@TypeOf(pid)))) + 1);
+fn fmtScopeId(buf: []u8, app_id: []const u8, pid: u32) error{NoSpaceLeft}![:0]const u8 {
+    const prefix = "app-ghostty-";
+    if (buf.len < prefix.len) return error.NoSpaceLeft;
+    @memcpy(buf[0..prefix.len], prefix);
+    var i: usize = prefix.len;
+
+    for (app_id) |c| {
+        if (c == '-') {
+            if (buf.len - i < 4) return error.NoSpaceLeft;
+            @memcpy(buf[i..][0..4], "\\x2d");
+            i += 4;
+        } else {
+            if (buf.len - i < 1) return error.NoSpaceLeft;
+            buf[i] = c;
+            i += 1;
+        }
+    }
+
+    const tail = try std.fmt.bufPrintZ(buf[i..], "-{}.scope", .{pid});
+    return buf[0 .. i + tail.len :0];
+}
 
-    return std.fmt.bufPrintZ(buf, fmt, .{pid}) catch unreachable;
+test fmtScope {
+    var buf: [256]u8 = undefined;
+    try std.testing.expectEqualStrings(
+        "app-ghostty-com.mitchellh.ghostty-42.scope",
+        fmtScope(&buf, "com.mitchellh.ghostty", 42),
+    );
+    try std.testing.expectEqualStrings(
+        "app-ghostty-com.mitchellh.ghostty\\x2ddebug-42.scope",
+        fmtScope(&buf, "com.mitchellh.ghostty-debug", 42),
+    );
+    try std.testing.expectEqualStrings(
+        "app-ghostty-com.mitchellh.ghostty-42.scope",
+        fmtScope(&buf, "a" ** 250, 42),
+    );
 }
 
