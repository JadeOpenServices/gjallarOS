+    /// Install shim and MokManager, or remove the shim measurement when shim is not used.
+    ///
+    /// Runs after systemd-boot is in place, so every shim copy finds its second stage. The copy
+    /// in the fallback path is written last: until then the firmware still starts what was there.
+    fn install_shim(&self) -> Result<()> {
+        let Some((files, paths)) = &self.shim else {
+            // Without shim, a measurement left from an earlier shim install would make the TPM
+            // policy expect a boot component that never runs.
+            if let Some(pcrlock_paths) = &self.pcrlock_paths {
+                let current = pcrlock_paths.shim_measurement("current");
+                if current.exists() {
+                    log::info!("Removing shim measurement {}", current.display());
+                    fs::remove_file(&current)
+                        .with_context(|| format!("Failed to remove {}", current.display()))?;
+                }
+            }
+            return Ok(());
+        };
+
+        for to in [&paths.nixos_mok_manager, &paths.fallback_mok_manager] {
+            install(&files.mok_manager, to)
+                .with_context(|| format!("Failed to install MokManager to: {to:?}"))?;
+        }
+
+        let shim_targets = [&paths.nixos_shim, &paths.fallback_shim];
+        let shim_hash = file_hash(&files.shim)?;
+        let mut shim_changed = false;
+        for to in shim_targets {
+            shim_changed |= !to.exists() || file_hash(to)? != shim_hash;
+        }
+
+        let measurement_exists = self
+            .pcrlock_paths
+            .as_ref()
+            .is_none_or(|p| p.shim_measurement("current").exists());
+
+        if shim_changed || !measurement_exists {
+            if let Some(pcrlock_paths) = &self.pcrlock_paths {
+                lock_pe(&files.shim, pcrlock_paths.shim_measurement("next"))
+                    .context("Failed to lock shim with systemd-pcrlock")?;
+            }
+
+            for to in shim_targets {
+                log::info!("Installing {}", to.display());
+                force_install(&files.shim, to)
+                    .with_context(|| format!("Failed to install shim to: {to:?}"))?;
+            }
+
+            if let Some(pcrlock_paths) = &self.pcrlock_paths {
+                let next = pcrlock_paths.shim_measurement("next");
+                let current = pcrlock_paths.shim_measurement("current");
+                fs::rename(&next, &current).with_context(|| {
+                    format!(
+                        "Failed to rename {} to {}",
+                        next.display(),
+                        current.display()
+                    )
+                })?;
+            }
+        }
+
+        Ok(())
+    }
