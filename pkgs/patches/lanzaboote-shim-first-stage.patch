+/// Where shim and systemd-boot go when the firmware trusts shim only.
+///
+/// shim loads `grub<arch>.efi` and `mm<arch>.efi` from its own directory, so each shim copy gets
+/// both next to it: one in `EFI/nixos`, where the boot entry and fwupd look for it, and one in the
+/// removable fallback path `EFI/BOOT`, which takes the place of systemd-boot there.
+pub struct ShimEspPaths {
+    pub nixos_shim: PathBuf,
+    pub nixos_mok_manager: PathBuf,
+    pub nixos_loader: PathBuf,
+    pub fallback_shim: PathBuf,
+    pub fallback_mok_manager: PathBuf,
+    pub fallback_loader: PathBuf,
+}
+
+impl ShimEspPaths {
+    pub fn new(esp_paths: &SystemdEspPaths, architecture: Architecture) -> Self {
+        let arch = architecture.efi_representation();
+        let shim = format!("shim{arch}.efi");
+        let mok_manager = format!("mm{arch}.efi");
+        let loader = format!("grub{arch}.efi");
+        Self {
+            nixos_shim: esp_paths.nixos.join(&shim),
+            nixos_mok_manager: esp_paths.nixos.join(&mok_manager),
+            nixos_loader: esp_paths.nixos.join(&loader),
+            fallback_shim: esp_paths.efi_fallback.clone(),
+            fallback_mok_manager: esp_paths.efi_fallback_dir.join(&mok_manager),
+            fallback_loader: esp_paths.efi_fallback_dir.join(&loader),
+        }
+    }
+
+    /// The files in `EFI/nixos`, which lzbt's garbage collection would otherwise delete.
+    pub fn nixos_files(&self) -> [&PathBuf; 3] {
+        [
+            &self.nixos_shim,
+            &self.nixos_mok_manager,
+            &self.nixos_loader,
+        ]
+    }
+}
