@@ -0,0 +1,191 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use anyhow::Result;
+use lanzaboote_tool::architecture::Architecture;
+use tempfile::{TempDir, tempdir};
+
+use crate::common::{self, SYSTEM, hash_file, mtime, verify_signature};
+
+// Stand-ins for the distribution's shim and MokManager. lzbt copies them as they are, so their
+// content does not matter here.
+const FAKE_SHIM: &[u8] = b"test stand-in for shim";
+const FAKE_MOK_MANAGER: &[u8] = b"test stand-in for MokManager";
+
+#[test]
+fn install_shim_as_first_stage() -> Result<()> {
+    let esp = tempdir()?;
+    let tmpdir = tempdir()?;
+    let profiles = tempdir()?;
+    let shim_dir = fake_shim_directory()?;
+    let generation_link = common::setup_generation_link(tmpdir.path(), profiles.path(), 1)
+        .expect("Failed to setup generation link");
+
+    let output = install_with_shim(&esp, &shim_dir, &generation_link)?;
+    assert!(output.status.success());
+
+    let p = Paths::new(esp.path());
+    for shim in [&p.nixos_shim, &p.fallback] {
+        assert_eq!(fs::read(shim)?, FAKE_SHIM, "{shim:?} is not shim");
+    }
+    for mok_manager in [&p.nixos_mok_manager, &p.fallback_mok_manager] {
+        assert_eq!(fs::read(mok_manager)?, FAKE_MOK_MANAGER, "{mok_manager:?} is not MokManager");
+    }
+    for loader in [&p.nixos_loader, &p.fallback_loader, &p.systemd_boot] {
+        assert!(verify_signature(loader)?, "{loader:?} is not a signed systemd-boot");
+    }
+
+    Ok(())
+}
+
+#[test]
+fn keep_shim_on_second_install() -> Result<()> {
+    let esp = tempdir()?;
+    let tmpdir = tempdir()?;
+    let profiles = tempdir()?;
+    let shim_dir = fake_shim_directory()?;
+    let generation_link = common::setup_generation_link(tmpdir.path(), profiles.path(), 1)
+        .expect("Failed to setup generation link");
+    let p = Paths::new(esp.path());
+
+    assert!(install_with_shim(&esp, &shim_dir, &generation_link)?.status.success());
+    let mtimes0 = p.all().map(|f| mtime(f));
+
+    // The garbage collection of EFI/nixos must keep the shim files.
+    assert!(install_with_shim(&esp, &shim_dir, &generation_link)?.status.success());
+    let mtimes1 = p.all().map(|f| mtime(f));
+
+    assert_eq!(mtimes0, mtimes1, "A boot file was rewritten on the second install.");
+
+    Ok(())
+}
+
+#[test]
+fn replace_changed_shim() -> Result<()> {
+    let esp = tempdir()?;
+    let tmpdir = tempdir()?;
+    let profiles = tempdir()?;
+    let shim_dir = fake_shim_directory()?;
+    let generation_link = common::setup_generation_link(tmpdir.path(), profiles.path(), 1)
+        .expect("Failed to setup generation link");
+    let p = Paths::new(esp.path());
+
+    assert!(install_with_shim(&esp, &shim_dir, &generation_link)?.status.success());
+    fs::write(&p.fallback, b"something else")?;
+    assert!(install_with_shim(&esp, &shim_dir, &generation_link)?.status.success());
+
+    assert_eq!(fs::read(&p.fallback)?, FAKE_SHIM);
+
+    Ok(())
+}
+
+#[test]
+fn switch_back_to_systemd_boot() -> Result<()> {
+    let esp = tempdir()?;
+    let tmpdir = tempdir()?;
+    let profiles = tempdir()?;
+    let shim_dir = fake_shim_directory()?;
+    let generation_link = common::setup_generation_link(tmpdir.path(), profiles.path(), 1)
+        .expect("Failed to setup generation link");
+    let p = Paths::new(esp.path());
+
+    assert!(install_with_shim(&esp, &shim_dir, &generation_link)?.status.success());
+    let shim_hash = hash_file(&p.fallback);
+
+    let output = common::lanzaboote_install(0, esp.path(), vec![&generation_link])?;
+    assert!(output.status.success());
+
+    assert_ne!(hash_file(&p.fallback), shim_hash, "shim is still the fallback loader");
+    assert!(verify_signature(&p.fallback)?);
+    for gone in [&p.nixos_shim, &p.nixos_mok_manager, &p.nixos_loader] {
+        assert!(!gone.exists(), "{gone:?} was not collected");
+    }
+
+    Ok(())
+}
+
+#[test]
+fn refuse_shim_directory_without_mok_manager() -> Result<()> {
+    let esp = tempdir()?;
+    let tmpdir = tempdir()?;
+    let profiles = tempdir()?;
+    let shim_dir = fake_shim_directory()?;
+    let generation_link = common::setup_generation_link(tmpdir.path(), profiles.path(), 1)
+        .expect("Failed to setup generation link");
+    fs::remove_file(shim_dir.path().join(format!("mm{}.efi", arch())))?;
+
+    let output = install_with_shim(&esp, &shim_dir, &generation_link)?;
+    assert!(!output.status.success());
+    assert!(!Paths::new(esp.path()).fallback.exists());
+
+    Ok(())
+}
+
+fn install_with_shim(
+    esp: &TempDir,
+    shim_dir: &TempDir,
+    generation_link: &Path,
+) -> Result<std::process::Output> {
+    common::lanzaboote_install_with_args(
+        0,
+        esp.path(),
+        vec![generation_link],
+        [
+            "--shim-directory".into(),
+            shim_dir.path().as_os_str().to_os_string(),
+        ],
+    )
+}
+
+fn fake_shim_directory() -> Result<TempDir> {
+    let dir = tempdir()?;
+    fs::write(dir.path().join(format!("shim{}.efi", arch())), FAKE_SHIM)?;
+    fs::write(dir.path().join(format!("mm{}.efi", arch())), FAKE_MOK_MANAGER)?;
+    Ok(dir)
+}
+
+fn arch() -> String {
+    Architecture::from_nixos_system(SYSTEM)
+        .unwrap()
+        .efi_representation()
+        .to_string()
+}
+
+struct Paths {
+    nixos_shim: PathBuf,
+    nixos_mok_manager: PathBuf,
+    nixos_loader: PathBuf,
+    fallback: PathBuf,
+    fallback_mok_manager: PathBuf,
+    fallback_loader: PathBuf,
+    systemd_boot: PathBuf,
+}
+
+impl Paths {
+    fn new(esp: &Path) -> Self {
+        let a = arch();
+        let nixos = esp.join("EFI/nixos");
+        let boot = esp.join("EFI/BOOT");
+        Self {
+            nixos_shim: nixos.join(format!("shim{a}.efi")),
+            nixos_mok_manager: nixos.join(format!("mm{a}.efi")),
+            nixos_loader: nixos.join(format!("grub{a}.efi")),
+            fallback: boot.join(format!("BOOT{}.EFI", a.to_ascii_uppercase())),
+            fallback_mok_manager: boot.join(format!("mm{a}.efi")),
+            fallback_loader: boot.join(format!("grub{a}.efi")),
+            systemd_boot: esp.join(format!("EFI/systemd/systemd-boot{a}.efi")),
+        }
+    }
+
+    fn all(&self) -> [&PathBuf; 7] {
+        [
+            &self.nixos_shim,
