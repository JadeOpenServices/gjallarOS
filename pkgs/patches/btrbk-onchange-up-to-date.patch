+# A snapshot holds the subvolume as of the transaction it was created in,
+# which is later than the last transaction that changed the subvolume: its
+# cgen is equal to the subvolume gen only if both happened in the same
+# transaction. Changes that are not committed yet do not show in the gen,
+# so commit them first and read the gen again.
+sub snapshot_up_to_date($$)
+{
+  my $svol = shift // die;
+  my $snapshot = shift // die;
+  # only a snapshot taken from this very subvolume holds its contents
+  return 0 unless(defined($svol->{node}{uuid}) && ($snapshot->{node}{parent_uuid} eq $svol->{node}{uuid}));
+  unless(defined(btrfs_filesystem_sync($svol))) {
+    WARN "Failed to sync filesystem, not skipping snapshot creation: $svol->{PRINT}", @stderr;
+    return 0;
+  }
+  my $detail = btrfs_subvolume_show($svol);
+  unless($detail && defined($detail->{uuid}) && ($detail->{uuid} eq $svol->{node}{uuid})) {
+    WARN "Failed to read subvolume generation, not skipping snapshot creation: $svol->{PRINT}";
+    return 0;
+  }
+  $svol->{node}{gen} = $detail->{gen};
+  return ($svol->{node}{gen} <= $snapshot->{node}{cgen});
+}
