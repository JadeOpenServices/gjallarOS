+sub btrfs_filesystem_sync($)
+{
+  my $vol = shift || die;
+  my $path = $vol->{PATH} // die;
+  return run_cmd( cmd => vinfo_cmd($vol, "btrfs filesystem sync", { unsafe => $path }),
+                  rsh => vinfo_rsh($vol),
+                  non_destructive => 1,
+                  filter_stderr => \&_btrfs_filter_stderr,
+                 );
+}
