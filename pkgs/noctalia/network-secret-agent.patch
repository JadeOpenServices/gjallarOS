     try {
       m_networkSecretAgent = std::make_unique<NetworkSecretAgent>(*m_systemBus);
+      // Same as Bluetooth below: with the Network tab closed, NM would wait
+      // unseen until it gives up, so a notification stays until the request
+      // ends. The panel is not opened by itself, so the keyboard stays with
+      // the window being typed in.
+      m_networkSecretAgent->setRequestCallback([this, shouldRefreshControlCenter,
+                                                shownRequest =
+                                                    std::make_shared<std::pair<std::uint32_t, std::uint64_t>>()](
+                                                   const NetworkSecretAgent::SecretRequest& request
+                                               ) {
+        if (shouldRefreshControlCenter()) {
+          m_panelManager.refresh();
+        }
+        auto* notifications = notify::instance();
+        if (notifications == nullptr) {
+          return;
+        }
+        const bool shown =
+            m_panelManager.isOpenPanel("control-center") && m_panelManager.isActivePanelContext("network");
+        const std::uint64_t key = request.settingName.empty() || shown ? 0 : request.id;
+        if (key == shownRequest->second) {
+          return;
+        }
+        if (shownRequest->first != 0) {
+          (void)notifications->close(shownRequest->first);
+        }
+        *shownRequest = {0, key};
+        if (key == 0) {
+          return;
+        }
+        const std::string ssid =
+            request.ssid.empty() ? i18n::tr("control-center.network.password-notify-unknown") : request.ssid;
+        shownRequest->first = notifications->addInternal(
+            "Network", i18n::tr("control-center.network.password-notify-title"),
+            i18n::tr("control-center.network.password-notify-body", "ssid", ssid), Urgency::Normal, 0
+        );
+      });
     } catch (const std::exception& e) {
       kLog.warn("network secret agent disabled: {}", e.what());
       m_networkSecretAgent.reset();
