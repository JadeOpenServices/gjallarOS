+  std::string settingsFileName(int version) { return std::format("settings.v{}.toml", version); }
+
+  namespace {
+
+    constexpr std::string_view kLegacySettingsFile = "settings.toml";
+
+    // The file a missing copy starts from: the newest older version's copy, else settings.toml
+    // unless it was written by a newer build. Empty when there is none.
+    std::filesystem::path settingsSeedSource(const std::filesystem::path& stateDir) {
+      const int current = currentConfigVersion();
+      std::error_code ec;
+      for (int version = current - 1; version >= 0; --version) {
+        const auto older = stateDir / settingsFileName(version);
+        if (std::filesystem::is_regular_file(older, ec)) {
+          return older;
+        }
+      }
+      const auto legacy = stateDir / kLegacySettingsFile;
+      if (!std::filesystem::is_regular_file(legacy, ec)) {
+        return {};
+      }
+      try {
+        const toml::table root = toml::parse_file(legacy.string());
+        if (const auto stored = root[kConfigVersionKey].value<std::int64_t>(); stored.has_value() && *stored > current) {
+          return {};
+        }
+      } catch (const toml::parse_error&) {
+        // Start from it anyway: loading reports the parse error as it always did.
+      }
+      return legacy;
+    }
+
+  } // namespace
+
+  std::filesystem::path settingsFileForRead(const std::filesystem::path& stateDir) {
+    std::error_code ec;
+    const auto legacy = stateDir / kLegacySettingsFile;
+    if (std::filesystem::is_symlink(legacy, ec)) {
+      return legacy;
+    }
+    const auto own = stateDir / settingsFileName();
+    if (std::filesystem::exists(own, ec)) {
+      return own;
+    }
+    const auto seed = settingsSeedSource(stateDir);
+    return seed.empty() ? own : seed;
+  }
+
+  std::filesystem::path prepareSettingsFile(const std::filesystem::path& stateDir) {
+    const auto source = settingsFileForRead(stateDir);
+    const auto own = stateDir / settingsFileName();
+    if (source == own || (source == stateDir / kLegacySettingsFile && std::filesystem::is_symlink(source))) {
+      return source;
+    }
+    // Copied under a temporary name and renamed, so a crash never leaves half a copy in use. If
+    // the copy fails the build still uses its own path and starts from defaults: migrating the
+    // source in place would break the older build that reads it.
+    std::error_code ec;
+    const auto partial = stateDir / (settingsFileName() + ".partial");
+    std::filesystem::copy_file(source, partial, std::filesystem::copy_options::overwrite_existing, ec);
+    if (!ec) {
+      std::filesystem::rename(partial, own, ec);
+    }
+    if (ec) {
+      std::filesystem::remove(partial, ec);
+    }
+    return own;
+  }
+
