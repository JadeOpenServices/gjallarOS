+namespace {
+
+  // The setup wizard saves the bundled wallpaper by its absolute path. On Nix
+  // that is a store path, which is gone once an update is garbage collected,
+  // leaving the desktop and lock screen without a wallpaper. Point a missing
+  // bundled asset at the same file in the running build.
+  std::string relinkBundledAsset(std::string path) {
+    constexpr std::string_view kAssetsDir = "/share/noctalia/assets/";
+    const auto pos = path.find(kAssetsDir);
+    if (pos == std::string::npos) {
+      return path;
+    }
+    std::error_code ec;
+    if (std::filesystem::exists(path, ec)) {
+      return path;
+    }
+    const std::string relative = path.substr(pos + kAssetsDir.size());
+    if (relative.empty() || relative.find("..") != std::string::npos) {
+      return path;
+    }
+    const auto current = paths::assetPath(relative);
+    if (!std::filesystem::is_regular_file(current, ec)) {
+      return path;
+    }
+    return current.string();
+  }
+
+} // namespace
