+
+void LockSurface::buildOsk() {
+  {
+    auto layer = ui::node({});
+    // Above the login and status panels: the keyboard is drawn last.
+    layer->setZIndex(8);
+    layer->setVisible(false);
+    m_oskLayer = m_root.addChild(std::move(layer));
+  }
+
+  m_oskLayer->addChild(
+      ui::flex(
+          FlexDirection::Horizontal,
+          {
+              .out = &m_oskPanel,
+              .configure = [](Flex& flex) { flex.setZIndex(0); },
+          }
+      )
+  );
+
+  // Keys never take keyboard focus: the password field keeps it, and the
+  // keyboard only ever types into that field. It has no clipboard, emoji,
+  // settings or launch keys and no word prediction, and no key previews the
+  // pressed character above the keyboard.
+  const auto addKey = [this](Button** out, std::optional<std::string> glyph, ButtonVariant variant,
+                             std::function<void()> onClick) {
+    m_oskLayer->addChild(
+        ui::button({
+            .out = out,
+            .glyph = std::move(glyph),
+            .variant = variant,
+            .onClick = std::move(onClick),
+            .configure =
+                [](Button& button) {
+                  button.setZIndex(1);
+                  button.setTabStop(false);
+                },
+        })
+    );
+  };
+
+  for (std::size_t i = 0; i < kOskCharKeyCount; ++i) {
+    addKey(&m_oskCharKeys[i], std::nullopt, ButtonVariant::Secondary, [this, i]() { oskTypeChar(i); });
+  }
+  addKey(&m_oskShiftKey, "arrow-big-up", ButtonVariant::Default, [this]() { oskCycleShift(); });
+  addKey(&m_oskSymbolShiftKey, std::nullopt, ButtonVariant::Default, [this]() {
+    oskSetPage(m_oskPage == OskPage::Symbols ? OskPage::MoreSymbols : OskPage::Symbols);
+  });
+  addKey(&m_oskBackspaceKey, "backspace", ButtonVariant::Default, [this]() { oskSendKey(XKB_KEY_BackSpace, 0); });
+  addKey(&m_oskPageKey, std::nullopt, ButtonVariant::Default, [this]() {
+    const bool letters = m_oskPage == OskPage::Letters || m_oskPage == OskPage::Accents;
+    oskSetPage(letters ? OskPage::Symbols : OskPage::Letters);
+  });
+  addKey(&m_oskAccentKey, std::nullopt, ButtonVariant::Default, [this]() {
+    oskSetPage(m_oskPage == OskPage::Accents ? OskPage::Letters : OskPage::Accents);
+  });
+  addKey(&m_oskSpaceKey, std::nullopt, ButtonVariant::Secondary, [this]() { oskSendKey(XKB_KEY_space, U' '); });
+  addKey(&m_oskHideKey, "keyboard-hide", ButtonVariant::Default, [this]() {
+    if (m_onOskVisibilityRequest) {
+      m_onOskVisibilityRequest(false);
+    }
+  });
+  addKey(&m_oskEnterKey, "corner-down-left", ButtonVariant::Primary, [this]() {
+    if (m_locked && !m_blackout && m_onLogin) {
+      m_onLogin();
+    }
+  });
+  m_oskAccentKey->setText("àé");
+
+  syncOskKeys();
+}
+
+char32_t LockSurface::oskCharAt(std::size_t index) const {
+  const bool upper = m_oskShift != OskShift::Off;
+  switch (m_oskPage) {
+  case OskPage::Letters:
+    return oskRowsCharAt(upper ? kOskLettersUpper : kOskLettersLower, index);
+  case OskPage::Symbols:
+    return oskRowsCharAt(kOskSymbols, index);
+  case OskPage::MoreSymbols:
+    return oskRowsCharAt(kOskMoreSymbols, index);
+  case OskPage::Accents:
+    return oskRowsCharAt(upper ? kOskAccentsUpper : kOskAccentsLower, index);
+  }
+  return 0;
+}
+
+void LockSurface::syncOskKeys() {
+  if (m_oskLayer == nullptr) {
+    return;
+  }
+  for (std::size_t i = 0; i < kOskCharKeyCount; ++i) {
+    const char32_t cp = oskCharAt(i);
+    m_oskCharKeys[i]->setVisible(cp != 0);
+    if (cp != 0) {
+      m_oskCharKeys[i]->setText(encodeUtf8(cp));
+    }
+  }
+
+  const bool symbols = m_oskPage == OskPage::Symbols || m_oskPage == OskPage::MoreSymbols;
+  m_oskShiftKey->setVisible(!symbols);
+  m_oskShiftKey->setGlyph(m_oskShift == OskShift::Locked ? "arrow-big-up-lines" : "arrow-big-up");
+  m_oskShiftKey->setSelected(m_oskShift != OskShift::Off);
+  m_oskSymbolShiftKey->setVisible(symbols);
+  m_oskSymbolShiftKey->setText(m_oskPage == OskPage::MoreSymbols ? "2/2" : "1/2");
+  m_oskPageKey->setText(symbols ? "ABC" : "?123");
+  m_oskAccentKey->setSelected(m_oskPage == OskPage::Accents);
+  requestLayout();
+}
+
+void LockSurface::oskTypeChar(std::size_t index) {
+  const char32_t cp = oskCharAt(index);
+  if (cp == 0) {
+    return;
+  }
+  oskSendKey(xkb_utf32_to_keysym(cp), cp);
+  if (m_oskShift == OskShift::Once) {
+    m_oskShift = OskShift::Off;
+    syncOskKeys();
+  }
+}
+
+void LockSurface::oskSendKey(std::uint32_t sym, std::uint32_t utf32) {
+  if (!m_locked || m_blackout || m_passwordField == nullptr) {
+    return;
+  }
+  // Pressing a key may have moved focus; the keyboard only types into the
+  // password field. No modifiers are ever sent, so no shortcut can fire.
+  focusPasswordField();
+  m_inputDispatcher.keyEvent(sym, utf32, 0, true, false);
+  m_inputDispatcher.keyEvent(sym, utf32, 0, false, false);
+  focusPasswordField();
+}
+
+void LockSurface::oskCycleShift() {
+  switch (m_oskShift) {
+  case OskShift::Off:
+    m_oskShift = OskShift::Once;
+    break;
+  case OskShift::Once:
+    m_oskShift = OskShift::Locked;
+    break;
+  case OskShift::Locked:
+    m_oskShift = OskShift::Off;
+    break;
+  }
+  syncOskKeys();
+}
+
+void LockSurface::oskSetPage(OskPage page) {
+  m_oskPage = page;
+  if (page == OskPage::Symbols || page == OskPage::MoreSymbols) {
+    m_oskShift = OskShift::Off;
+  }
+  syncOskKeys();
+}
+
+float LockSurface::layoutOsk(
+    Renderer& renderer, float sw, float sh, bool show, const lockscreen_login_box::LoginBoxStyle& style
+) {
+  if (m_oskLayer == nullptr) {
+    return sh;
+  }
+  m_oskLayer->setVisible(show);
+  if (!show) {
+    return sh;
+  }
+
+  const float pad = Style::spaceSm;
+  const float gap = Style::spaceXs;
+  const float kbWidth = std::min(sw, kOskMaxWidth);
+  const float keyW = std::floor((kbWidth - 2.0F * pad - 9.0F * gap) / 10.0F);
+  const float keyH = std::round(std::clamp(sh * 0.075F, kOskMinKeyHeight, kOskMaxKeyHeight));
+  const float kbHeight = 4.0F * keyH + 3.0F * gap + 2.0F * pad;
+  const float kbX = std::round((sw - kbWidth) * 0.5F);
+  const float kbY = sh - kbHeight;
+  const float rowW = 10.0F * keyW + 9.0F * gap;
+  const float x0 = kbX + std::round((kbWidth - rowW) * 0.5F);
+  const float wideW = 1.5F * keyW + 0.5F * gap;
+  const float fontSize = std::round(keyH * 0.4F);
+  const float radius = Style::scaledRadius(style.inputRadius);
+
+  m_oskLayer->setPosition(0.0F, 0.0F);
+  m_oskLayer->setSize(sw, sh);
+
+  m_oskPanel->setFill(style.panelFill);
+  m_oskPanel->setBorder(colorForRole(ColorRole::Outline, style.panelOpacity), Style::borderWidth);
+  m_oskPanel->setRadius(Style::scaledRadius(style.panelRadius));
+  m_oskPanel->setSoftness(1.0F);
+  m_oskPanel->setMinWidth(kbWidth);
+  m_oskPanel->setMaxWidth(kbWidth);
+  m_oskPanel->setMinHeight(kbHeight);
+  m_oskPanel->setMaxHeight(kbHeight);
+  m_oskPanel->arrange(renderer, LayoutRect{kbX, kbY, kbWidth, kbHeight});
+
+  const auto place = [&](Button* key, float x, float y, float w, bool text) {
+    key->setRadius(radius);
+    if (text) {
+      key->setFontSize(fontSize);
+    } else {
+      key->setGlyphSize(fontSize);
+    }
+    key->setMinWidth(w);
+    key->setMaxWidth(w);
+    key->setControlHeight(keyH);
+    key->arrange(renderer, LayoutRect{x, y, w, keyH});
+  };
+
+  const float rowY0 = kbY + pad;
+  const float step = keyW + gap;
+  for (std::size_t i = 0; i < kOskTopCount; ++i) {
+    place(m_oskCharKeys[i], x0 + static_cast<float>(i) * step, rowY0, keyW, true);
+  }
+  const float rowY1 = rowY0 + keyH + gap;
+  const float x1 = x0 + std::round(step * 0.5F);
+  for (std::size_t i = 0; i < kOskMiddleCount; ++i) {
+    place(m_oskCharKeys[kOskTopCount + i], x1 + static_cast<float>(i) * step, rowY1, keyW, true);
+  }
+  const float rowY2 = rowY1 + keyH + gap;
+  place(m_oskShiftKey, x0, rowY2, wideW, false);
+  place(m_oskSymbolShiftKey, x0, rowY2, wideW, true);
+  const float x2 = x0 + wideW + gap;
+  const std::size_t bottomCount = kOskCharKeyCount - kOskTopCount - kOskMiddleCount;
+  for (std::size_t i = 0; i < bottomCount; ++i) {
+    place(m_oskCharKeys[kOskTopCount + kOskMiddleCount + i], x2 + static_cast<float>(i) * step, rowY2, keyW, true);
+  }
+  place(m_oskBackspaceKey, x0 + rowW - wideW, rowY2, wideW, false);
+
+  const float rowY3 = rowY2 + keyH + gap;
+  const float spaceW = 5.0F * keyW + 4.0F * gap;
+  float x = x0;
+  place(m_oskPageKey, x, rowY3, wideW, true);
+  x += wideW + gap;
+  place(m_oskAccentKey, x, rowY3, keyW, true);
+  x += keyW + gap;
+  place(m_oskSpaceKey, x, rowY3, spaceW, true);
+  x += spaceW + gap;
+  place(m_oskHideKey, x, rowY3, keyW, false);
+  x += keyW + gap;
+  place(m_oskEnterKey, x, rowY3, wideW, false);
+
+  return kbY;
+}
