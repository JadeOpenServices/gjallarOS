+  // True when a keyboard is attached that a person can type on: built in,
+  // USB or similar. Virtual devices (on-screen keyboards, uinput tools) and
+  // Bluetooth keyboards do not count, since a Bluetooth keyboard may not be
+  // paired or reachable at the lock screen. When unsure, report no keyboard:
+  // showing the on-screen keyboard is the safe side.
+  bool hasPhysicalKeyboard() {
+    udev* ctx = udev_new();
+    if (ctx == nullptr) {
+      return false;
+    }
+    bool found = false;
+    udev_enumerate* enumerate = udev_enumerate_new(ctx);
+    if (enumerate != nullptr) {
+      udev_enumerate_add_match_subsystem(enumerate, "input");
+      udev_enumerate_add_match_sysname(enumerate, "event*");
+      udev_enumerate_add_match_property(enumerate, "ID_INPUT_KEYBOARD", "1");
+      udev_enumerate_scan_devices(enumerate);
+      udev_list_entry* entry = nullptr;
+      udev_list_entry_foreach(entry, udev_enumerate_get_list_entry(enumerate)) {
+        const char* syspath = udev_list_entry_get_name(entry);
+        if (syspath == nullptr || std::strstr(syspath, "/devices/virtual/") != nullptr) {
+          continue;
+        }
+        udev_device* device = udev_device_new_from_syspath(ctx, syspath);
+        if (device == nullptr) {
+          continue;
+        }
+        udev_device* parent = udev_device_get_parent_with_subsystem_devtype(device, "input", nullptr);
+        const char* bus = parent != nullptr ? udev_device_get_sysattr_value(parent, "id/bustype") : nullptr;
+        if (bus != nullptr) {
+          const unsigned long busType = std::strtoul(bus, nullptr, 16);
+          found = busType != BUS_BLUETOOTH && busType != BUS_VIRTUAL;
+        }
+        udev_device_unref(device);
+        if (found) {
+          break;
+        }
+      }
+      udev_enumerate_unref(enumerate);
+    }
+    udev_unref(ctx);
+    return found;
+  }
