+  [[nodiscard]] char32_t oskRowsCharAt(const OskRows& rows, std::size_t index) {
+    const auto pick = [](std::u32string_view row, std::size_t i) -> char32_t { return i < row.size() ? row[i] : 0; };
+    if (index < kOskTopCount) {
+      return pick(rows.top, index);
+    }
+    index -= kOskTopCount;
+    if (index < kOskMiddleCount) {
+      return pick(rows.middle, index);
+    }
+    return pick(rows.bottom, index - kOskMiddleCount);
