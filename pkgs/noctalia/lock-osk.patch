+void LockSurface::setOskVisible(bool visible) {
+  if (m_oskVisible == visible) {
+    return;
+  }
+  m_oskVisible = visible;
+  if (!visible) {
+    // Open on the letters page next time, as phones do.
+    m_oskPage = OskPage::Letters;
+    m_oskShift = OskShift::Off;
+    syncOskKeys();
+  }
+  requestLayout();
+}
