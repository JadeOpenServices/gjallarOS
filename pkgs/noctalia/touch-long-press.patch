+void InputDispatcher::armTouchLongPress(float x, float y, std::uint32_t serial, std::uint32_t time) {
+  m_touchLongPress = TouchLongPress{.armed = true, .pressX = x, .pressY = y, .serial = serial, .time = time};
+  m_touchLongPressTimer.start(kTouchLongPressDelay, [this]() { fireTouchLongPress(); });
+}
+
+void InputDispatcher::cancelTouchLongPress() {
+  m_touchLongPress = {};
+  m_touchLongPressTimer.stop();
+}
+
+void InputDispatcher::fireTouchLongPress() {
+  const auto press = std::exchange(m_touchLongPress, {});
+  if (!press.armed) {
+    return;
+  }
+  pruneDetachedAreas();
+  InputArea* target = inputAreaAcceptingButton(findInputAreaAt(press.pressX, press.pressY), BTN_RIGHT);
+  if (target == nullptr) {
+    // Nothing here has a secondary action; lifting the finger stays a plain tap.
+    return;
+  }
+  // Drop the primary press (or the pending scroll gesture) so the lift cannot click.
+  cancelPointerCapture();
+  m_swallowTouchRelease = true;
+
+  float localX = 0.0F;
+  float localY = 0.0F;
+  (void)Node::mapFromScene(target, press.pressX, press.pressY, localX, localY);
+  m_capturedArea = target;
+  trackArea(target);
+  target->dispatchPress(localX, localY, BTN_RIGHT, true, press.pressX, press.pressY, press.serial, press.time);
+  // The press handler may rebuild the scene; the destroy callback clears the capture then.
+  if (m_capturedArea == target) {
+    m_capturedArea = nullptr;
+    target->dispatchPress(localX, localY, BTN_RIGHT, false, press.pressX, press.pressY, press.serial, press.time);
+  }
+}
