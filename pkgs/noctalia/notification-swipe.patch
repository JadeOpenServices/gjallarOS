+// Swipe a card sideways to dismiss it: drag with a mouse or finger, or scroll
+// horizontally on a touchpad. A quarter of the card width or a quick flick is
+// enough; anything less springs back.
+void NotificationToast::installSwipeToDismiss(
+    Instance& inst, InputArea* area, const std::shared_ptr<SwipeState>& swipe, uint32_t notificationId, float cardW,
+    float scale
+) {
+  SwipeState* const state = swipe.get();
+  const float restX = horizontalInnerPad(scale);
+  const float slop = 8.0F * scale;
+  const float threshold = cardW * 0.25F;
+  // Release speed that dismisses however short the swipe was, in px/ms. Android
+  // dismisses notifications from 500 dp/s on (SwipeHelper), so does this.
+  const float flingSpeed = 0.5F * scale;
+
+  const auto moveTo = [area, state, restX, cardW](float dx) {
+    state->dx = dx;
+    area->setPosition(restX + dx, area->y());
+    area->setOpacity(std::clamp(1.0F - std::abs(dx) / cardW, 0.0F, 1.0F));
+  };
+
+  // Speed is measured on the events' own timestamps, not on when they are read:
+  // a busy shell reads a whole touch burst at once, which would look like no
+  // time passed. Follows the speed with a short smoothing, so one jittery event
+  // does not decide a fling. Events with the same timestamp add up and count
+  // once time moves on; time 0 marks synthetic motion, which moves the card but
+  // says nothing about speed.
+  const auto track = [state](float dx, std::uint32_t time) {
+    if (time == 0) {
+      return;
+    }
+    const std::uint32_t dt = time - state->lastTime;
+    if (dt == 0) {
+      return;
+    }
+    const float v = (dx - state->lastDx) / static_cast<float>(dt);
+    if (dt >= 100) {
+      state->velocity = 0.0F;
+    } else if (state->velocity == 0.0F) {
+      state->velocity = v;
+    } else {
+      state->velocity = 0.6F * v + 0.4F * state->velocity;
+    }
+    state->lastTime = time;
+    state->lastDx = dx;
+  };
+
+  const auto settle = [this, &inst, area, state, moveTo, threshold, flingSpeed, slop, cardW,
+                       notificationId](std::uint32_t time) {
+    // time is when the finger left; a finger that stopped first is not flinging.
+    if (state->animId != 0) {
+      inst.animations.cancel(state->animId);
+      state->animId = 0;
+    }
+    const float from = state->dx;
+    const bool fresh = time - state->lastTime < 100;
+    const bool flung = fresh && std::abs(from) >= slop && state->velocity * from > 0.0F
+        && std::abs(state->velocity) >= flingSpeed;
+    state->velocity = 0.0F;
+    if (std::abs(from) >= threshold || flung) {
+      const float to = std::copysign(cardW, from);
+      state->animId = inst.animations.animate(
+          from, to, Style::animFast, Easing::EaseOutCubic, moveTo,
+          [this, area, state, notificationId]() {
+            state->animId = 0;
+            area->setOpacity(0.0F);
+            DeferredCall::callLater([this, notificationId]() { requestClose(notificationId, CloseReason::Dismissed); });
+          },
+          area
+      );
+    } else if (from != 0.0F) {
+      state->animId = inst.animations.animate(
+          from, 0.0F, Style::animNormal, Easing::EaseOutCubic, moveTo, [state]() { state->animId = 0; }, area
+      );
+    }
+    inst.surface->requestRedraw();
+  };
+
+  area->setOnPress([&inst, area, state, settle](const InputArea::PointerData& data) {
+    if (data.button != BTN_LEFT) {
+      return;
+    }
+    if (data.pressed) {
+      if (state->animId != 0) {
+        inst.animations.cancel(state->animId);
+        state->animId = 0;
+      }
+      state->tracking = true;
+      state->moved = false;
+      state->startX = data.localX + area->x() - state->dx;
+      state->velocity = 0.0F;
+      state->lastTime = data.time;
+      state->lastDx = state->dx;
+      return;
+    }
+    if (state->tracking) {
+      state->tracking = false;
+      settle(data.time);
+    }
+  });
+
+  area->setOnMotion([area, state, moveTo, track, slop](const InputArea::PointerData& data) {
+    if (!state->tracking || !area->pressed()) {
+      return;
+    }
+    // Local coordinates move with the card, so add the card position back.
+    const float dx = data.localX + area->x() - state->startX;
+    if (!state->moved && std::abs(dx) < slop) {
+      return;
+    }
+    state->moved = true;
+    track(dx, data.time);
+    moveTo(dx);
+  });
+
+  area->setOnCancel([state, settle]() {
+    if (state->tracking) {
+      state->tracking = false;
+      // No release time: settle on distance alone.
+      settle(state->lastTime + 100);
+    }
+  });
+
+  area->setOnAxisHandler([&inst, state, moveTo, track, settle](const InputArea::PointerData& data) {
+    if (data.axis != WL_POINTER_AXIS_HORIZONTAL_SCROLL || data.axisSource != WL_POINTER_AXIS_SOURCE_FINGER
+        || state->tracking) {
+      return false;
+    }
+    if (state->animId != 0) {
+      inst.animations.cancel(state->animId);
+      state->animId = 0;
+    }
+    if (!state->moved) {
+      state->velocity = 0.0F;
+      state->lastTime = data.time;
+      state->lastDx = state->dx;
+    }
+    state->moved = true;
+    const float dx = state->dx - static_cast<float>(data.axisValue);
+    track(dx, data.time);
+    moveTo(dx);
+    // Touchpads send no reliable end event here; settle once the fingers stop.
+    // The fingers left with the last event, so judge the fling at that time.
+    state->axisIdle.start(std::chrono::milliseconds(120), [state, settle]() {
+      state->moved = false;
+      settle(state->lastTime);
+    });
+    return true;
+  });
+}
