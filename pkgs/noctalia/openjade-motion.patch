+  // cubic-bezier(0.16, 1, 0.3, 1): find the curve parameter whose x is t
+  // (x rises with it), then return its y.
+  float houseCurve(float t) {
+    const auto bezier = [](float p1, float p2, float s) {
+      const float u = 1.0F - s;
+      return 3.0F * u * u * s * p1 + 3.0F * u * s * s * p2 + s * s * s;
+    };
+    float lo = 0.0F;
+    float hi = 1.0F;
+    float s = t;
+    for (int i = 0; i < 24; ++i) {
+      s = 0.5F * (lo + hi);
+      if (bezier(0.16F, 0.3F, s) < t) {
+        lo = s;
+      } else {
+        hi = s;
+      }
+    }
+    return bezier(1.0F, 1.0F, s);
+  }
+
+} // namespace
