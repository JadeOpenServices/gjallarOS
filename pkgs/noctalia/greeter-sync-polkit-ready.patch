+
+// The greeter helper asks for the password through this shell's own polkit
+// agent. Started before the agent is registered, pkexec finds no agent for
+// the session and fails, so the look is never applied. A sync asked for in
+// that window waits until the agent is up or known to be off.
+void Application::runGreeterAutoSync() {
+  if (polkitAgentStarting()) {
+    m_greeterAutoSyncWaiting = true;
+    return;
+  }
+  performGreeterSync(true);
+}
+
+void Application::resumeGreeterAutoSync() {
+  if (!m_greeterAutoSyncWaiting) {
+    return;
+  }
+  m_greeterAutoSyncWaiting = false;
+  scheduleGreeterAutoSync();
+}
+
+bool Application::polkitAgentStarting() const noexcept {
+  if (!m_configService.config().shell.polkitAgent) {
+    return false;
+  }
+  if (!m_polkitAgentChecked) {
+    return true;
+  }
+  return m_polkitAgent != nullptr && !m_polkitAgentReady;
 }
 
