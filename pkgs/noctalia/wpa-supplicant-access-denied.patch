Our own fix, not upstream (upstream v5.4.0 has the same gap):
a wpa_supplicant that answers AccessDenied is no usable backend, so the
NetworkManager backend keeps waiting instead of losing to it at startup.

diff --git a/src/dbus/network/wpa_supplicant_service.cpp b/src/dbus/network/wpa_supplicant_service.cpp
index 2c44a88195..408ee9c26a 100644
--- a/src/dbus/network/wpa_supplicant_service.cpp
+++ b/src/dbus/network/wpa_supplicant_service.cpp
@@ -133,6 +133,11 @@ WpaSupplicantService::WpaSupplicantService(SystemBus& bus) : m_bus(bus) {
       subscribeInterface(std::string(p));
     }
   } catch (const sdbus::Error& e) {
+    // A wpa_supplicant owned by NetworkManager is on the bus but closed to users by its bus policy. It is
+    // no usable backend then, and taking it over would keep the NetworkManager backend from waiting.
+    if (e.getName() == sdbus::Error::Name{"org.freedesktop.DBus.Error.AccessDenied"}) {
+      throw;
+    }
     kLog.warn("failed to enumerate interfaces: {}", e.what());
   }
 
