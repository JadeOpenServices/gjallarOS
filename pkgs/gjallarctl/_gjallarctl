#compdef gjallarctl rebuild helpme cleanup cleanup-old-generations thermal-status thermal-test check-installer gjallar-preflight

# Hand-written: gjallarctl parses its own arguments, so nothing can be
# generated. Keep in step with printUsage in cmd/gjallarctl/main.go. The
# other names are the wrappers in system/tools/commands/default.nix.

_gjallarctl_rebuild() {
  _arguments -S \
    '(- *)'{-h,--help}'[show help]' \
    '--repo[GjallarOS checkout]:checkout:_files -/' \
    '--host[host name]:host:' \
    '(-d --debug)'{-d,--debug}'[show the full build output]' \
    '(-n --no-cleanup)'{-n,--no-cleanup}'[keep old generations]' \
    '--update[update the checkout first]' \
    '--update-inputs[update the flake inputs first]' \
    '--hardware-update[move the ODDC hardware catalogue pin first]' \
    '--channel[ODDC channel]:channel:(stable staging)' \
    '--switch[switch after the hardware update]:switch:(0 1)' \
    '*::nixos-rebuild argument:'
}

_gjallarctl_system() {
  local -a cmds=(
    'check:check the root-owned system checkout (root only)'
    'rebuild:rebuild from the system checkout (root only, started by rebuild)'
    'apply:copy ~/GjallarOS-local into the system and rebuild (developer mode)'
    'status:show what the running system was built from'
    'move:show what moving to the root-owned system checkout leaves behind'
    'clone:create the root-owned system checkout (root only)'
    'developer-off:turn developer mode off and build the official system (recovery entry, root only)'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'system command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  case $words[1] in
    clone)
      _arguments '--from[the checkout the system builds now]:directory:_files -/' ;;
  esac
}

_gjallarctl_usb() {
  local -a cmds=(
    'status:show the USB trust broker state'
    'audit:list connected devices and their verdicts'
    'policy:show the active policy'
    'review:review blocked devices'
    'provision-key:create the TPM signing key'
    'allow-once:allow a device until it is unplugged'
    'trust-permanent:trust a device on this port'
    'keep-blocked:keep a device blocked'
    'enroll-internal:enroll a built-in device'
    'accept-replacement:accept a replaced built-in device'
    'forget:forget a trusted device'
    'renew:keep trusting a device whose trust lapses soon'
    'disarm:turn enforcement off until the next arm'
    'allow-media:open the card or storage in an allowed reader'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'usb command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  _arguments \
    '--runtime-id[device runtime id]:id:' \
    '--connection[connection token]:token:' \
    '--trusted-id[trusted device id]:id:' \
    '--role[ODDC expectation role]:role:' \
    '--portable=-[portable device]:portable:(true false)' \
    '--media[storage medium id (H:C:T:L)]:id:'
}

_gjallarctl_thunderbolt() {
  local -a cmds=(
    'status:list Thunderbolt devices and DMA protection'
    'review:ask about blocked devices (session service)'
    'allow-once:let a device in until it is unplugged'
    'always-allow:let a device in now and on every later connect'
    'forget:stop always allowing a device'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'thunderbolt command' cmds
    return
  fi
  _arguments '--uid[device UID from thunderbolt status]:uid:'
}

_gjallarctl_luks() {
  local -a cmds=(
    'status:show how the system disk unlocks'
    'recovery-key:create a new recovery key'
    'setup:add a recovery key and remove the install passphrase'
    'pin:set, change or remove the startup PIN'
    'remind:ask about missing disk protection, as at login'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'luks command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  case $words[1] in
    pin)
      _arguments '--remove[remove the startup PIN]' ;;
    remind)
      _arguments '(--refresh)--open[start the missing setup right away]' '(--open)--refresh[only update the bar shield]' ;;
  esac
}

_gjallarctl_vpn() {
  local -a cmds=(
    'status:show VPN and Wi-Fi trust state'
    'trust-wifi:trust a Wi-Fi network'
    'untrust-wifi:stop trusting a Wi-Fi network'
    'exit-node:pick the exit node'
    'export:print the state.nix line for these changes'
    'apply:apply a network trust policy'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'vpn command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  case $words[1] in
    trust-wifi)
      _arguments '--exit-node[exit node]:node:(auto default)' '1:network name:' ;;
    exit-node)
      _arguments '1:exit node:(auto off default)' ;;
    apply)
      _arguments '--policy[network trust policy JSON]:file:_files -g "*.json"' \
        '--override[runtime override JSON]:file:_files -g "*.json"' ;;
  esac
}

_gjallarctl_addons() {
  local -a cmds=(
    'list:show Firefox add-on collections and store add-ons'
    'set:turn a collection or add-on off, on or locked'
    'pin:add an add-on from addons.mozilla.org'
    'update:pin the newest version of store add-ons'
    'reconcile:remove add-ons GjallarOS no longer wants'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'addons command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  local -a targets
  local store='*[@{]*' addon='*[.@{]*'
  case $words[1] in
    list)
      _arguments '--names[print only the names set accepts]' \
        '--repo[GjallarOS checkout]:checkout:_files -/' ;;
    set)
      targets=(${(f)"$(gjallarctl addons list --names 2>/dev/null)"})
      if (( CURRENT == 2 )); then
        _describe -t targets 'collection or add-on' targets
      elif (( CURRENT == 3 )); then
        if [[ $words[2] == $~addon ]]; then
          _values mode off on locked
        else
          _values mode on off
        fi
      else
        _arguments '--repo[GjallarOS checkout]:checkout:_files -/'
      fi ;;
    pin)
      _arguments '--mode[how to install it]:mode:(on locked)' \
        '(-y --yes)'{-y,--yes}'[accept without asking]' \
        '--repo[GjallarOS checkout]:checkout:_files -/' \
        '1:add-on ID (about\:support lists it):' ;;
    update)
      targets=(${(f)"$(gjallarctl addons list --names 2>/dev/null)"})
      targets=(${(M)targets:#$~store})
      _arguments '(-y --yes)'{-y,--yes}'[accept without asking]' \
        '--repo[GjallarOS checkout]:checkout:_files -/' \
        "*:store add-on:(${targets[*]})" ;;
    reconcile)
      _arguments '1:app:(firefox)' \
        '--desired[wanted add-ons JSON]:file:_files -g "*.json"' \
        '--profile[Firefox profile]:profile:_files -/' ;;
  esac
}

_gjallarctl_settings() {
  local -a cmds=(
    'list:show every setting with its tier and value'
    'get:show the value of one setting'
    'set:ask for a change; it is written after the wait of its tier'
    'pending:show the changes waiting in this session'
    'apply:write a waiting change and rebuild'
    'cancel:drop a waiting change'
    'export:save the settings in a file signed with your key'
    'import:ask for the change a saved settings file makes'
    'pair:trust settings files of your account on another device'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'settings command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  local -a keys ids
  case $words[1] in
    list) _arguments '--names[print only the keys set accepts]' ;;
    get)
      keys=(${(f)"$(gjallarctl settings list --names 2>/dev/null)"})
      _arguments "1:setting:(${keys[*]})" ;;
    set)
      if [[ $PREFIX != *=* ]]; then
        keys=(${(f)"$(gjallarctl settings list --names 2>/dev/null)"})
        compadd -S= -- $keys
      fi ;;
    pending) _arguments '--ids[print only the change ids]' ;;
    apply|cancel)
      ids=(${(f)"$(gjallarctl settings pending --ids 2>/dev/null)"})
      _arguments "1:change id:(${ids[*]})" ;;
    export|import) _arguments '1:settings file:_files' ;;
    pair) _gjallarctl_settings_pair ;;
  esac
}

_gjallarctl_settings_pair() {
  local -a cmds=(
    'export:save a pairing file for your other device'
    'add:pair with the device that made a pairing file'
    'list:show the paired devices'
    'remove:stop trusting a paired device'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'pair command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  local -a ids
  case $words[1] in
    export|add) _arguments '1:pairing file:_files' ;;
    list) _arguments '--ids[print only the pairing ids]' ;;
    remove)
      ids=(${(f)"$(gjallarctl settings pair list --ids 2>/dev/null)"})
      _arguments "1:pairing id:(${ids[*]})" ;;
  esac
}

_gjallarctl_snapshots() {
  local -a cmds=(
    'list:show the snapshots of /home, newest first'
    'restore:copy one of your files back from a snapshot'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'snapshots command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  local -a names
  case $words[1] in
    list) _arguments '--names[print only the snapshot names]' ;;
    restore)
      names=(${(f)"$(gjallarctl snapshots list --names 2>/dev/null)"})
      _arguments '1:file:_files' \
        "--from[snapshot to restore from]:snapshot:(${names[*]})" \
        '--to[folder for the copy]:folder:_files -/' ;;
  esac
}

_gjallarctl_oddc() {
  local -a cmds=(
    'validate-device:check this machine against its ODDC model'
    'update:move the ODDC pin'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'oddc command' cmds
    return
  fi
  shift words
  (( CURRENT-- ))
  case $words[1] in
    validate-device)
      _arguments '--repo[GjallarOS checkout]:checkout:_files -/' ;;
    update)
      _arguments '--repo[GjallarOS checkout]:checkout:_files -/' \
        '--rebuild[rebuild after the update]' \
        '(--debug)--simple[print only the result line]' \
        '(--simple)--debug[print the ODDC state before and after]' ;;
  esac
}

_gjallarctl() {
  case $service in
    rebuild) _gjallarctl_rebuild; return ;;
    helpme) _arguments '--text[print instead of opening a window]'; return ;;
    cleanup) _arguments '(-k --keep)'{-k,--keep}'[generations to keep]:count:'; return ;;
    cleanup-old-generations|thermal-status|gjallar-preflight) _message 'no arguments'; return ;;
    thermal-test) _arguments '1:mode:(off on status)' '2:process pattern:_process_names'; return ;;
    check-installer) _arguments '--timeout[time per external check]:duration:'; return ;;
  esac

  local -a cmds=(
    'rebuild:rebuild and switch the system'
    'auth:authenticate sudo (fingerprint, then password)'
    'helpme:list the GjallarOS tools'
    'check:run the safe repository checks'
    'preflight:check the repository before a rebuild'
    'system:root side of the system checkout rebuild'
    'usb:USB trust enforcement'
    'thunderbolt:Thunderbolt and USB4 device authorization'
    'vpn:VPN and trusted Wi-Fi'
    'addons:Firefox add-ons'
    'settings:change GjallarOS settings'
    'snapshots:restore your files from the /home snapshots'
    'tpm2:TPM2 disk unlock'
    'luks:system disk unlock methods and recovery key'
    'secure-boot:Secure Boot with GjallarOS keys'
    'security:security notes for this device from ODDC'
    'oddc:ODDC hardware catalogue'
    'fan:fan control'
    'thermal-status:show temperatures and fan state'
    'cleanup:delete old generations'
    'cleanup-old-generations:delete generations older than the kept ones'
    'thermal-test:pause (off) or resume (on) matching processes'
    'ai:local AI'
    'preset:read user.config.json presets'
    'normalize:normalize a setting'
    'device-probe:refresh the hardware probe'
    'hyprland-rotate:turn screens and input with the orientation sensor (session service)'
    'hyprland-render-gpu:offer a new login when a new screen wants another GPU (session service)'
  )

  _arguments -C '1:command:->cmd' '*::argument:->args'
  case $state in
    cmd) _describe -t commands 'gjallarctl command' cmds ;;
    args)
      case $words[1] in
        rebuild) _gjallarctl_rebuild ;;
        system) _gjallarctl_system ;;
        usb) _gjallarctl_usb ;;
        thunderbolt) _gjallarctl_thunderbolt ;;
        vpn) _gjallarctl_vpn ;;
        addons) _gjallarctl_addons ;;
        settings) _gjallarctl_settings ;;
        snapshots) _gjallarctl_snapshots ;;
        oddc) _gjallarctl_oddc ;;
        helpme) _arguments '--text[print instead of opening a window]' ;;
        tpm2) _arguments '1:tpm2 command:((reenroll\:"enroll the TPM2 key again"))' ;;
        luks) _gjallarctl_luks ;;
        security) _arguments '1:security command:((notice\:"show new security notes once, as at login" oddc-notice\:"show the notice while ODDC is off its pin"))' ;;
        secure-boot)
          _arguments '1:secure-boot command:((status\:"show Secure Boot ownership" setup\:"set up Secure Boot on this installed system" update-dbx\:"install the newest dbx revocation list from LVFS"))' \
            '--repo[GjallarOS checkout]:checkout:_files -/' ;;
        fan) _arguments '1:fan command:(status list reconcile)' ;;
        cleanup) _arguments '(-k --keep)'{-k,--keep}'[generations to keep]:count:' ;;
        thermal-test) _arguments '1:mode:(off on status)' '2:process pattern:_process_names' ;;
        check)
          _arguments '--repo[GjallarOS checkout]:checkout:_files -/' \
            '--timeout[time per external check]:duration:' ;;
        preflight) _arguments '--repo[GjallarOS checkout]:checkout:_files -/' ;;
        ai)
          _arguments '1:ai command:((enable\:"turn local AI on; the rebuild picks the model" profile\:"show the profile this machine gets" set-token\:"store the bearer token of the AI server"))' \
            '--config[user configuration]:file:_files -g "*.json"' ;;
        preset)
          _arguments '1:preset command:(validate get list bool)' \
            '--config[preset JSON]:file:_files -g "*.json"' \
            '--key[preset field]:key:' ;;
        normalize) _arguments '1:setting:(keyboard)' '--layout[XKB layout]:layout:' ;;
        device-probe)
          _arguments '1:device-probe command:(refresh)' \
            '--output[output path]:file:_files' ;;
        hyprland-rotate)
          _arguments '--tablet-switch[rotate only in tablet mode of this switch]:input device name:' \
            '--require-tablet-switch[treat a missing tablet mode switch as laptop mode]' ;;
        hyprland-render-gpu) _message 'no arguments' ;;
      esac ;;
  esac
}

_gjallarctl "$@"
