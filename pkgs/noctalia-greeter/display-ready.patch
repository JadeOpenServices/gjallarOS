+// The boot splash stays up, without the display, until the greeter shows
+// something. Creating $NOCTALIA_GREETER_DISPLAY_READY tells the system that
+// this compositor now drives a screen and the splash can go.
+static void note_display_ready(void) {
+  static bool noted = false;
+  if (noted) {
+    return;
+  }
+  noted = true;
+
+  const char* path = getenv("NOCTALIA_GREETER_DISPLAY_READY");
+  if (path == NULL || path[0] == '\0') {
+    return;
+  }
+  const int fd = open(path, O_WRONLY | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+  if (fd < 0) {
+    wlr_log(WLR_ERROR, "failed to create %s: %s", path, strerror(errno));
+    return;
+  }
+  close(fd);
+}
+
 static bool commit_output_enabled(struct greeter_output* output) {
   struct greeter_server* server = output->server;
   if (!initialize_output_render(output)) {
@@ -1299,6 +1322,7 @@ static bool commit_output_enabled(struct greeter_output* output) {
 
