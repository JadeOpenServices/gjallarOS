+static bool has_physical_keyboard(struct greeter_server* server) {
+  struct greeter_keyboard* keyboard;
+  wl_list_for_each(keyboard, &server->keyboards, link) {
+    if (keyboard->is_physical) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// True for a built-in, USB or similar keyboard. Virtual devices (uinput tools,
+// the on-screen keyboard itself) and Bluetooth keyboards do not count: a
+// Bluetooth keyboard is not paired or reachable before login. Switches and
+// button devices that only carry a few keys (power button, tablet buttons)
+// are not keyboards to udev and do not count either.
+static bool keyboard_device_is_physical(struct wlr_input_device* device) {
+  if (!wlr_input_device_is_libinput(device)) {
+    // Nested backends (wayland, x11) are driven from a real keyboard.
+    return true;
+  }
+  struct libinput_device* libinput_dev = wlr_libinput_get_device_handle(device);
+  struct udev_device* udev_dev = libinput_dev != NULL ? libinput_device_get_udev_device(libinput_dev) : NULL;
+  if (udev_dev == NULL) {
+    return false;
+  }
+  bool physical = false;
+  const char* syspath = udev_device_get_syspath(udev_dev);
+  const char* keyboard = udev_device_get_property_value(udev_dev, "ID_INPUT_KEYBOARD");
+  if (syspath != NULL && strstr(syspath, "/devices/virtual/") == NULL && keyboard != NULL &&
+      strcmp(keyboard, "1") == 0) {
+    const unsigned int bus = libinput_device_get_id_bustype(libinput_dev);
+    physical = bus != BUS_BLUETOOTH && bus != BUS_VIRTUAL;
+  }
+  udev_device_unref(udev_dev);
+  return physical;
+}
