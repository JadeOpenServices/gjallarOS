+static void osk_set_visible(struct greeter_server* server, bool visible) {
+  if (server->osk_pid <= 0 || (!visible && !server->osk_visible)) {
+    return;
+  }
+  // wvkbd(1): SIGUSR1 hides, SIGUSR2 shows. Always show: it can hide itself.
+  if (kill(server->osk_pid, visible ? SIGUSR2 : SIGUSR1) == 0) {
+    server->osk_visible = visible;
+  }
+}
+
+// Layer-shell and virtual-keyboard let a client cover the greeter and type
+// into it, so only the keyboard started by start_osk gets to see them.
+static bool filter_global(const struct wl_client* client, const struct wl_global* global, void* data) {
+  struct greeter_server* server = data;
+  const bool osk_only = (server->layer_shell != NULL && global == server->layer_shell->global) ||
+                        (server->virtual_keyboard_mgr != NULL && global == server->virtual_keyboard_mgr->global);
+  if (!osk_only) {
+    return true;
+  }
+  return server->osk_client != NULL && client == server->osk_client;
+}
+
+static void handle_osk_client_destroy(struct wl_listener* listener, void* data) {
+  (void)data;
+  struct greeter_server* server = wl_container_of(listener, server, osk_client_destroy);
+  remove_listener_if_set(&server->osk_client_destroy);
+  server->osk_client = NULL;
+}
+
+static void handle_new_virtual_keyboard(struct wl_listener* listener, void* data) {
+  struct greeter_server* server = wl_container_of(listener, server, new_virtual_keyboard);
+  struct wlr_virtual_keyboard_v1* virtual_keyboard = data;
+  if (server->shutting_down || wl_resource_get_client(virtual_keyboard->resource) != server->osk_client) {
+    return;
+  }
+  add_keyboard(server, &virtual_keyboard->keyboard.base);
+  recompute_keyboard_capability(server);
+}
+
+static void handle_layer_surface_commit(struct wl_listener* listener, void* data) {
+  (void)data;
+  struct greeter_layer_surface* layer = wl_container_of(listener, layer, commit);
+  struct wlr_layer_surface_v1* layer_surface = layer->layer_surface;
+  if (!layer_surface->initialized || (!layer_surface->initial_commit && layer_surface->current.committed == 0)) {
+    return;
+  }
+  struct wlr_box full_area;
+  wlr_output_layout_get_box(layer->server->output_layout, layer_surface->output, &full_area);
+  if (wlr_box_empty(&full_area)) {
+    return;
+  }
+  struct wlr_box usable_area = full_area;
+  wlr_scene_layer_surface_v1_configure(layer->scene, &full_area, &usable_area);
+}
+
+// wvkbd draws key previews in an xdg popup of its layer surface and drops
+// every touch until that popup has been configured.
+static void handle_popup_commit(struct wl_listener* listener, void* data) {
+  (void)data;
+  struct greeter_popup* popup = wl_container_of(listener, popup, commit);
+  if (popup->xdg_popup->base->initial_commit) {
+    wlr_xdg_surface_schedule_configure(popup->xdg_popup->base);
+  }
+}
+
+static void handle_popup_destroy(struct wl_listener* listener, void* data) {
+  (void)data;
+  struct greeter_popup* popup = wl_container_of(listener, popup, destroy);
+  wl_list_remove(&popup->commit.link);
+  wl_list_remove(&popup->destroy.link);
+  free(popup);
+}
+
+static void handle_layer_surface_new_popup(struct wl_listener* listener, void* data) {
+  struct greeter_layer_surface* layer = wl_container_of(listener, layer, new_popup);
+  struct wlr_xdg_popup* xdg_popup = data;
+  struct greeter_popup* popup = calloc(1, sizeof(*popup));
+  if (popup == NULL) {
+    wl_client_post_no_memory(wl_resource_get_client(xdg_popup->resource));
+    return;
+  }
+  popup->xdg_popup = xdg_popup;
+  if (wlr_scene_xdg_surface_create(layer->scene->tree, xdg_popup->base) == NULL) {
+    free(popup);
+    wl_client_post_no_memory(wl_resource_get_client(xdg_popup->resource));
+    return;
+  }
+  popup->commit.notify = handle_popup_commit;
+  wl_signal_add(&xdg_popup->base->surface->events.commit, &popup->commit);
+  popup->destroy.notify = handle_popup_destroy;
+  wl_signal_add(&xdg_popup->events.destroy, &popup->destroy);
+}
+
+static void handle_layer_surface_destroy(struct wl_listener* listener, void* data) {
+  (void)data;
+  struct greeter_layer_surface* layer = wl_container_of(listener, layer, destroy);
+  wl_list_remove(&layer->commit.link);
+  wl_list_remove(&layer->new_popup.link);
+  wl_list_remove(&layer->destroy.link);
+  wl_list_remove(&layer->link);
+  free(layer);
+}
+
+static struct greeter_output* output_for_layer_surface(struct greeter_server* server) {
+  struct greeter_output* fallback = NULL;
+  struct greeter_output* output;
+  wl_list_for_each(output, &server->outputs, link) {
+    if (!output->active) {
+      continue;
+    }
+    if (output->view != NULL) {
+      return output;
+    }
+    if (fallback == NULL) {
+      fallback = output;
+    }
+  }
+  return fallback;
+}
+
+static void handle_new_layer_surface(struct wl_listener* listener, void* data) {
+  struct greeter_server* server = wl_container_of(listener, server, new_layer_surface);
+  struct wlr_layer_surface_v1* layer_surface = data;
+  if (layer_surface->output == NULL) {
+    struct greeter_output* output = output_for_layer_surface(server);
+    if (output == NULL) {
+      wlr_layer_surface_v1_destroy(layer_surface);
+      return;
+    }
+    layer_surface->output = output->wlr_output;
+  }
+
+  struct greeter_layer_surface* layer = calloc(1, sizeof(*layer));
+  if (layer == NULL) {
+    wlr_layer_surface_v1_destroy(layer_surface);
+    return;
+  }
+  layer->server = server;
+  layer->layer_surface = layer_surface;
+  layer->scene = wlr_scene_layer_surface_v1_create(server->overlay_tree, layer_surface);
+  if (layer->scene == NULL) {
+    free(layer);
+    wlr_layer_surface_v1_destroy(layer_surface);
+    return;
+  }
+  layer->commit.notify = handle_layer_surface_commit;
+  wl_signal_add(&layer_surface->surface->events.commit, &layer->commit);
+  layer->new_popup.notify = handle_layer_surface_new_popup;
+  wl_signal_add(&layer_surface->events.new_popup, &layer->new_popup);
+  layer->destroy.notify = handle_layer_surface_destroy;
+  wl_signal_add(&layer_surface->events.destroy, &layer->destroy);
+  wl_list_insert(&server->layer_surfaces, &layer->link);
+}
