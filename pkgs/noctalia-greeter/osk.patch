+// The keyboard gets a connection made here before the fork (WAYLAND_SOCKET),
+// so the compositor knows which client it is without trusting pids.
+static void start_osk(struct greeter_server* server) {
+  const char* osk_bin = getenv("NOCTALIA_GREETER_OSK");
+  if (osk_bin == NULL || osk_bin[0] == '\0' || server->layer_shell == NULL) {
+    return;
+  }
+
+  int fds[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, fds) != 0) {
+    wlr_log(WLR_ERROR, "on-screen keyboard: socketpair failed: %s", strerror(errno));
+    return;
+  }
+  server->osk_client = wl_client_create(server->display, fds[0]);
+  if (server->osk_client == NULL) {
+    wlr_log(WLR_ERROR, "on-screen keyboard: wl_client_create failed");
+    close(fds[0]);
+    close(fds[1]);
+    return;
+  }
+  server->osk_client_destroy.notify = handle_osk_client_destroy;
+  wl_client_add_destroy_listener(server->osk_client, &server->osk_client_destroy);
+
+  // Build the child's environment before fork; only exec-safe calls after it.
+  extern char** environ;
+  size_t env_count = 0;
+  while (environ[env_count] != NULL) {
+    env_count++;
+  }
+  char** envp = calloc(env_count + 2, sizeof(char*));
+  char socket_env[32];
+  snprintf(socket_env, sizeof(socket_env), "WAYLAND_SOCKET=%d", fds[1]);
+  if (envp == NULL) {
+    close(fds[1]);
+    wl_client_destroy(server->osk_client);
+    return;
+  }
+  size_t env_out = 0;
+  for (size_t i = 0; i < env_count; ++i) {
+    if (strncmp(environ[i], "WAYLAND_SOCKET=", 15) != 0) {
+      envp[env_out++] = environ[i];
+    }
+  }
+  envp[env_out++] = socket_env;
+  envp[env_out] = NULL;
+
+  pid_t pid = fork();
+  if (pid < 0) {
+    wlr_log(WLR_ERROR, "on-screen keyboard: fork failed: %s", strerror(errno));
+    free(envp);
+    close(fds[1]);
+    wl_client_destroy(server->osk_client);
+    return;
+  }
+  if (pid == 0) {
+    int flags = fcntl(fds[1], F_GETFD);
+    if (flags < 0 || fcntl(fds[1], F_SETFD, flags & ~FD_CLOEXEC) != 0) {
+      _exit(127);
+    }
+    char* const argv[] = {(char*)osk_bin, (char*)"--hidden", NULL};
+    execve(osk_bin, argv, envp);
+    _exit(127);
+  }
+  free(envp);
+  close(fds[1]);
+  server->osk_pid = pid;
+  server->osk_visible = false;
+  wlr_log(WLR_INFO, "started on-screen keyboard: %s", osk_bin);
+}
